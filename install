#!/usr/bin/env bash
# One-shot installer: packages, fonts, dotfiles, themes, and the session.
#
#   ./install                 install everything, starting on Nacre
#   ./install --rice paper    start on another rice
#   ./install --dry-run       show what would happen, change nothing
#   ./install --uninstall     remove the links (your backed-up files stay put)
#
# Options:
#   --rice NAME     the rice to make active (default: keep the current one, else nacre)
#   --no-deps       don't install packages (just report what's missing)
#   --no-fonts      don't download Italiana, Manrope and IBM Plex Mono (Paper's
#                   fonts ship in the repo's fonts/ package and are always linked)
#   --no-firefox    don't touch Firefox profiles
#   --system        also theme Limine, the Plymouth splash and the greetd/ReGreet
#                   login screen (runs sudo system/install --all; asks for sudo)
#   --fresh         for a new minimal Arch install: also add what a desktop
#                   needs (NetworkManager, PipeWire, Bluetooth, portals, polkit
#                   agent, Firefox, Nautilus, Noto fonts), build paru for the AUR
#                   packages, enable the services, and imply --system
#   -y, --yes       don't ask before installing packages
#   -n, --dry-run   print the steps instead of running them
#
# Files the dotfiles would replace are moved to ~/.local/state/rice/backup/<time>/
# first, never deleted. Running it again is safe: it only fixes what's missing.
set -euo pipefail

repo=$(cd "$(dirname "$0")" && pwd)
packages=(switcher render rices hypr quickshell systemd fonts zsh)
backup="${XDG_STATE_HOME:-$HOME/.local/state}/rice/backup/$(date +%Y%m%d-%H%M%S)"
fontdir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/rice"
fonts_url="https://raw.githubusercontent.com/google/fonts/main/ofl"

rice="" deps=1 fonts=1 firefox=1 system=0 fresh=0 yes=0 dry=0 uninstall=0

# ── output ──────────────────────────────────────────────────────────────
if [ -t 1 ]; then b=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' grn=$'\e[32m' ylw=$'\e[33m' off=$'\e[0m'
else b="" dim="" red="" grn="" ylw="" off=""; fi
step() { printf '\n%s==> %s%s\n' "$b" "$*" "$off"; }
ok()   { printf '  %s✓%s %s\n' "$grn" "$off" "$*"; }
warn() { printf '  %s!%s %s\n' "$ylw" "$off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$red" "$off" "$*" >&2; exit 1; }
# run a command, or just show it under --dry-run
run() {
    if [ "$dry" = 1 ]; then printf '  %s$ %s%s\n' "$dim" "$*" "$off"; else "$@"; fi
}
have() { command -v "$1" >/dev/null 2>&1; }
ask() {
    [ "$yes" = 1 ] && return 0
    [ -t 0 ] || return 0
    read -r -p "  $1 [Y/n] " reply
    [[ ! $reply =~ ^[Nn] ]]
}

usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; }

while [ $# -gt 0 ]; do
    case $1 in
        --rice) rice=${2:?--rice needs a name}; shift ;;
        --rice=*) rice=${1#*=} ;;
        --no-deps) deps=0 ;;
        --no-fonts) fonts=0 ;;
        --no-firefox) firefox=0 ;;
        --system|--greetd) system=1 ;;
        --fresh) fresh=1 system=1 ;;
        -y|--yes) yes=1 ;;
        -n|--dry-run) dry=1 ;;
        --uninstall) uninstall=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option $1 (see --help)" ;;
    esac
    shift
done

[ "$(id -u)" -ne 0 ] || die "run this as yourself, not root; it asks for sudo when it needs it"
if [ "$fresh" = 1 ]; then
    [ "$deps" = 1 ] || die "--fresh installs packages; it can't be combined with --no-deps"
    have pacman || die "--fresh is for Arch Linux (it needs pacman)"
fi

# ── uninstall ───────────────────────────────────────────────────────────
if [ "$uninstall" = 1 ]; then
    have stow || die "stow is needed to remove the links"
    step "Removing the links"
    run systemctl --user disable --now rice-mode.timer rice-auto.timer 2>/dev/null || true
    run stow -D -d "$repo" -t "$HOME" "${packages[@]}"
    [ "$(git -C "$repo" config core.hooksPath 2>/dev/null)" = .githooks ] \
        && run git -C "$repo" config --unset core.hooksPath
    ok "done. Rendered themes stay in ~/.config/rices/*/build; earlier backups are in"
    printf '    %s\n' "${backup%/*}"
    exit 0
fi

# ── packages ────────────────────────────────────────────────────────────
# command → Arch package. Other distros: install these by hand.
required=(
    hyprland:hyprland qs:quickshell stow:stow python3:python jq:jq
    grim:grim slurp:slurp wl-copy:wl-clipboard cliphist:cliphist
    brightnessctl:brightnessctl hypridle:hypridle hyprsunset:hyprsunset
    playerctl:playerctl wpctl:wireplumber notify-send:libnotify
    xdg-open:xdg-utils flock:util-linux fc-list:fontconfig curl:curl kitty:kitty
)
optional=(
    satty:satty fd:fd cava:cava hyprpicker:hyprpicker magick:imagemagick
    powerprofilesctl:power-profiles-daemon bluetoothctl:bluez-utils
    hyprlock:hyprlock swaync:swaync swww:swww nvim:neovim
    qt6ct:qt6ct
    hyprshutdown:hyprshutdown
    zsh:zsh starship:starship eza:eza
    wf-recorder:wf-recorder pactl:libpulse
)
# Python modules, checked by import: Pillow regenerates Paper's paper textures
# and wallpaper (rices/paper/assets/gen.py)
pymods=(
    "PIL|python-pillow"
)
# themes the palettes name (checked by folder, since they aren't commands)
themes=(
    "adw-gtk3|adw-gtk-theme"
    "Colloid-Light|colloid-icon-theme-git"
    "Bibata-Modern-Ice|bibata-cursor-theme-bin"
    "Papirus-Light|papirus-icon-theme"
)

# zsh plugins and the Nerd Font glyphs, checked by file since they aren't
# commands (or by pacman when the file is "-")
files=(
    "/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh|zsh-autosuggestions"
    "/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh|zsh-syntax-highlighting"
    "/usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh|zsh-history-substring-search"
    "-|zsh-completions"                       # no single telltale file: asked of pacman
    "/usr/share/fonts/TTF/SymbolsNerdFontMono-Regular.ttf|ttf-nerd-fonts-symbols-mono"
)

missing_pkgs() {
    local entry
    for entry in "$@"; do have "${entry%%:*}" || printf '%s\n' "${entry#*:}"; done
}
missing_pymods() {
    local entry
    for entry in "${pymods[@]}"; do
        python3 -c "import ${entry%%|*}" 2>/dev/null || printf '%s\n' "${entry#*|}"
    done
}
missing_themes() {
    local entry name d found
    for entry in "${themes[@]}"; do
        name=${entry%%|*} found=0
        for d in /usr/share/themes /usr/share/icons "$HOME/.local/share/themes" "$HOME/.local/share/icons" "$HOME/.themes" "$HOME/.icons"; do
            [ -d "$d/$name" ] && { found=1; break; }
        done
        [ "$found" = 1 ] || printf '%s\n' "${entry#*|}"
    done
}
missing_files() {
    local entry
    for entry in "${files[@]}"; do
        # the file, or failing that pacman's word that the package is in
        [ -e "${entry%%|*}" ] || { have pacman && pacman -Qq "${entry#*|}" >/dev/null 2>&1; } \
            || printf '%s\n' "${entry#*|}"
    done
}

# ── fresh system ────────────────────────────────────────────────────────
# What a minimal Arch install lacks that the rice leans on: the bar's network
# widget talks to NetworkManager, screen sharing and file pickers need the
# portals, password prompts need a polkit agent, and three themes are AUR-only.
fresh_pkgs=(
    git base-devel networkmanager bluez bluez-utils power-profiles-daemon
    pipewire pipewire-pulse pipewire-alsa wireplumber
    xdg-desktop-portal-hyprland xdg-desktop-portal-gtk hyprpolkitagent
    firefox nautilus noto-fonts noto-fonts-cjk noto-fonts-emoji wpa_supplicant
    gnome-keyring libsecret seahorse
    wf-recorder
    zsh starship eza zsh-autosuggestions zsh-syntax-highlighting
    zsh-history-substring-search zsh-completions ttf-nerd-fonts-symbols-mono
)

# graphics drivers for the GPUs in this machine, read from sysfs (lspci may not
# be installed yet): Mesa's OpenGL plus Vulkan and video decoding
gpu_pkgs() {
    local v
    for v in /sys/class/drm/card*/device/vendor; do
        [ -r "$v" ] || continue
        case $(cat "$v") in
            0x8086) echo mesa vulkan-intel intel-media-driver ;;
            0x1002) echo mesa vulkan-radeon ;;
            0x10de) warn "NVIDIA GPU: install nvidia-open-dkms and nvidia-utils yourself (see the Arch wiki's NVIDIA page)" ;;
        esac
    done
}

# the first AUR helper that actually runs: a prebuilt paru-bin/yay-bin stops
# loading when pacman moves to a new libalpm, so being on PATH isn't enough
aur_helper() {
    local h
    for h in paru yay; do
        have "$h" && "$h" --version >/dev/null 2>&1 && { echo "$h"; return 0; }
    done
    return 1
}

# build paru from source, so it links against the libalpm that's installed
build_paru() {
    local h pkg build
    for h in paru yay; do
        have "$h" && warn "$h is installed but doesn't run (built for an older pacman)"
    done
    ask "Build paru from source (a few minutes) for the AUR-only themes?" || return 0
    for pkg in paru-bin yay-bin; do
        pacman -Qq "$pkg" >/dev/null 2>&1 && run sudo pacman -Rns --noconfirm "$pkg"
    done
    build=$(mktemp -d)
    run git clone --depth 1 https://aur.archlinux.org/paru.git "$build/paru"
    if [ "$dry" = 1 ]; then run makepkg -si --noconfirm
    else (cd "$build/paru" && makepkg -si --noconfirm) || warn "paru didn't build; AUR themes will be skipped"; fi
    rm -rf "$build"
}

if [ "$fresh" = 1 ]; then
    step "Fresh system"
    read -ra gpu <<< "$(gpu_pkgs | tr '\n' ' ')"
    [ ${#gpu[@]} -gt 0 ] && fresh_pkgs+=("${gpu[@]}")
    echo "  base: ${fresh_pkgs[*]}"
    if ask "Install them?"; then
        run sudo pacman -Syu --needed --noconfirm "${fresh_pkgs[@]}"
    fi

    if helper=$(aur_helper); then
        ok "AUR helper: $helper"
    else
        build_paru
    fi

    # NetworkManager next to another network daemon would fight over the
    # interfaces mid-install, so the old one is only disabled: it keeps the
    # network up until the reboot, and NetworkManager starts from then on
    others=()
    for svc in systemd-networkd iwd dhcpcd netctl; do
        systemctl is-active --quiet "$svc" 2>/dev/null && others+=("$svc")
    done
    if [ ${#others[@]} -eq 0 ]; then
        run sudo systemctl enable --now NetworkManager.service
    else
        run sudo systemctl disable "${others[@]/%/.service}"
        run sudo systemctl enable NetworkManager.service
        warn "NetworkManager takes over from ${others[*]} after a reboot"
    fi
    run sudo systemctl enable --now bluetooth.service power-profiles-daemon.service
    ok "NetworkManager, Bluetooth and power profiles enabled"
fi

step "Packages"
mapfile -t need < <(missing_pkgs "${required[@]}")
mapfile -t want < <(missing_pkgs "${optional[@]}"; missing_pymods; missing_themes; missing_files)
if [ ${#need[@]} -eq 0 ] && [ ${#want[@]} -eq 0 ]; then
    ok "everything is installed"
elif [ "$deps" = 0 ] || ! have pacman; then
    [ ${#need[@]} -gt 0 ] && warn "missing (required): ${need[*]}"
    [ ${#want[@]} -gt 0 ] && warn "missing (optional): ${want[*]}"
    have pacman || [ "$deps" = 0 ] || warn "automatic install only knows pacman; install these yourself"
else
    all=("${need[@]}" "${want[@]}")
    echo "  to install: ${all[*]}"
    if ask "Install them?"; then
        # official repos through pacman, the rest through an AUR helper if there is one
        repo_pkgs=() aur_pkgs=()
        for p in "${all[@]}"; do
            if pacman -Si "$p" >/dev/null 2>&1; then repo_pkgs+=("$p"); else aur_pkgs+=("$p"); fi
        done
        [ ${#repo_pkgs[@]} -gt 0 ] && run sudo pacman -S --needed --noconfirm "${repo_pkgs[@]}"
        if [ ${#aur_pkgs[@]} -gt 0 ]; then
            helper=$(aur_helper) || { build_paru; helper=$(aur_helper) || helper=""; }
            if [ -n "$helper" ]; then
                run "$helper" -S --needed --noconfirm "${aur_pkgs[@]}"
            else
                warn "not in the repos and no AUR helper (paru/yay): ${aur_pkgs[*]}"
            fi
        fi
    fi
    mapfile -t need < <(missing_pkgs "${required[@]}")
    [ "$dry" = 1 ] || [ ${#need[@]} -eq 0 ] || warn "still missing: ${need[*]}"
fi

have stow || die "stow is required to link the dotfiles"
have python3 || die "python3 is required for rice-render"
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' \
    || die "rice-render needs Python 3.11 or newer"

# ── Spicetify ───────────────────────────────────────────────────────────
# Themes Spotify. Taken from Spicetify's own release rather than the AUR,
# whose build (pnpm + esbuild) breaks on some systems.
install_spicetify() {
    local arch tag dir=$HOME/.spicetify
    case $(uname -m) in
        x86_64) arch=amd64 ;;
        aarch64) arch=arm64 ;;
        *) warn "no Spicetify release for $(uname -m)"; return 0 ;;
    esac
    tag=$(curl -fsSL -H 'Accept: application/json' https://github.com/spicetify/cli/releases/latest \
        | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n1) || true
    [ -n "$tag" ] || { warn "couldn't look up Spicetify's latest release"; return 0; }
    local url="https://github.com/spicetify/cli/releases/download/v$tag/spicetify-$tag-linux-$arch.tar.gz"
    run mkdir -p "$dir" "$HOME/.local/bin"
    if [ "$dry" = 1 ]; then run curl -fsSL "$url" '|' tar -xz -C "$dir"
    elif ! curl -fsSL "$url" | tar -xz -C "$dir"; then warn "Spicetify didn't download"; return 0; fi
    run ln -sf "$dir/spicetify" "$HOME/.local/bin/spicetify"
    ok "Spicetify $tag"
}

if have spotify || have spotify-launcher; then
    step "Spicetify"
    if have spicetify || [ -x "$HOME/.spicetify/spicetify" ]; then
        ok "installed"
    elif ask "Install Spicetify to theme Spotify?"; then
        install_spicetify
    fi
    # the AUR spotify package lives in /opt, which Spicetify has to patch
    if [ -d /opt/spotify ] && [ ! -w /opt/spotify/Apps ] \
        && ask "Spicetify needs write access to /opt/spotify; allow it?"; then
        run sudo chmod a+wr /opt/spotify
        run sudo chmod -R a+wr /opt/spotify/Apps
    fi
    # Spotify runs under XWayland by default, where Hyprland scales it up into
    # blurry text; these flags make it a native Wayland window. The AUR
    # wrapper reads spotify-flags.conf, spotify-launcher its own config.
    flags="$HOME/.config/spotify-flags.conf"
    if ! grep -qs ozone "$flags"; then
        if [ "$dry" = 1 ]; then run append ozone flags to "$flags"
        else printf '%s\n' --enable-features=UseOzonePlatform,WaylandWindowDecorations --ozone-platform=wayland >> "$flags"; fi
        ok "Spotify runs on Wayland (sharp text)"
    fi
    launcher="$HOME/.config/spotify-launcher.conf"
    if [ ! -e "$launcher" ]; then
        if [ "$dry" = 1 ]; then run write "$launcher"
        else printf '[spotify]\nextra_arguments = ["--enable-features=UseOzonePlatform", "--ozone-platform=wayland"]\n' > "$launcher"; fi
    elif ! grep -qs ozone "$launcher"; then
        warn "add --ozone-platform=wayland to extra_arguments in $launcher for sharp text"
    fi
fi

# ── fonts ───────────────────────────────────────────────────────────────
# family|style|file: each style is checked on its own, so a weight added later
# (the palettes use SemiBold and Bold) is fetched even if the family is there.
# Manrope is one variable font holding every weight; Italiana has one weight.
font_files=(
    "Italiana||italiana/Italiana-Regular.ttf"
    "Manrope||manrope/Manrope%5Bwght%5D.ttf"
    "IBM Plex Mono|Regular|ibmplexmono/IBMPlexMono-Regular.ttf"
    "IBM Plex Mono|Italic|ibmplexmono/IBMPlexMono-Italic.ttf"
    "IBM Plex Mono|Medium|ibmplexmono/IBMPlexMono-Medium.ttf"
    "IBM Plex Mono|SemiBold|ibmplexmono/IBMPlexMono-SemiBold.ttf"
    "IBM Plex Mono|SemiBold Italic|ibmplexmono/IBMPlexMono-SemiBoldItalic.ttf"
    "IBM Plex Mono|Bold|ibmplexmono/IBMPlexMono-Bold.ttf"
    "IBM Plex Mono|Bold Italic|ibmplexmono/IBMPlexMono-BoldItalic.ttf"
)

have_font() {   # have_font FAMILY [STYLE]
    have fc-list || return 1
    if [ -n "$2" ]; then
        fc-list ":family=$1:style=$2" family | grep -q .
    else
        fc-list : family | tr ',' '\n' | grep -qx "$1"
    fi
}

step "Fonts"
fetched=0 missing=""
for entry in "${font_files[@]}"; do
    IFS='|' read -r family style file <<< "$entry"
    have_font "$family" "$style" && continue
    if [ "$fonts" = 0 ] || ! have curl; then
        missing="$missing, $family${style:+ $style}"
        continue
    fi
    name=$(basename "$file" | sed 's/%5B/[/; s/%5D/]/')
    run mkdir -p "$fontdir"
    if run curl -fsSL -o "$fontdir/$name" "$fonts_url/$file"; then
        ok "$family${style:+ $style} (downloaded)"
        fetched=1
    else
        warn "couldn't download $name"
    fi
done
[ -n "$missing" ] && warn "not installed: ${missing#, }"
[ "$fetched" = 0 ] && [ -z "$missing" ] && ok "Italiana, Manrope, IBM Plex Mono"
[ "$fetched" = 1 ] && have fc-cache && run fc-cache -f "$fontdir" >/dev/null
# Courier Prime, Kalam and Newsreader (Paper) are OFL fonts kept in the repo's
# fonts/ package; stow links them below and fc-cache picks them up there

# ── dotfiles ────────────────────────────────────────────────────────────
step "Linking the dotfiles"
# Move aside anything stow would refuse to overwrite: real files, and links
# that point somewhere other than this repo.
moved=0
move_aside() {
    local target=$1 rel=${1#"$HOME"/}
    run mkdir -p "$(dirname "$backup/$rel")"
    run mv "$target" "$backup/$rel"
    warn "moved ~/$rel to the backup"
    moved=1
}
for pkg in "${packages[@]}"; do
    while IFS= read -r -d '' src; do
        rel=${src#"$repo/$pkg/"}
        target="$HOME/$rel"
        if [ -L "$target" ]; then
            [ "$(readlink -f "$target")" = "$(readlink -f "$src")" ] || move_aside "$target"
        elif [ -e "$target" ]; then
            move_aside "$target"
        fi
    done < <(find "$repo/$pkg" \( -name __pycache__ -o -name build -o -name current \) -prune \
                 -o \( -type f -o -type l \) -print0)
done
# an old hyprland.conf next to the Lua entry point would compete with it
[ -e "$HOME/.config/hypr/hyprland.conf" ] && move_aside "$HOME/.config/hypr/hyprland.conf"

run stow --no-folding --ignore='__pycache__' --ignore='^build$' -d "$repo" -t "$HOME" -R "${packages[@]}"
ok "linked: ${packages[*]}"
# after every `git pull`, tools/relink links the files the pull added (git
# hooks in .githooks/); a hooks path you set yourself is left alone
if have git && git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    hooks="$(git -C "$repo" config core.hooksPath || true)"
    if [ -z "$hooks" ] || [ "$hooks" = .githooks ]; then
        run git -C "$repo" config core.hooksPath .githooks
        ok "git pull re-links new files (tools/relink)"
    else
        warn "core.hooksPath is $hooks: run tools/relink yourself after a pull"
    fi
fi
paperfonts="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/paper"
if have fc-cache && [ -d "$paperfonts" ]; then
    run fc-cache -f "$paperfonts" >/dev/null
    ok "fonts: Courier Prime, Kalam, Newsreader"
fi
if [ "$moved" = 1 ]; then
    echo "  your old files are in $backup"
    echo "  machine-specific Hyprland bits (monitors, keyboard) go in ~/.config/hypr/local.lua"
fi
# zsh: one line in ~/.zshrc pulls in the shared setup (prompt, completion,
# suggestions, highlighting); everything else in ~/.zshrc stays yours
zsh_line='[ -f ~/.config/zsh/rice.zsh ] && source ~/.config/zsh/rice.zsh'
if ! grep -qsF "$zsh_line" "$HOME/.zshrc"; then
    if [ "$dry" = 1 ]; then run append "'$zsh_line'" to ~/.zshrc
    else printf '\n# the rice: prompt, completion, suggestions, highlighting\n%s\n' "$zsh_line" >> "$HOME/.zshrc"; fi
    ok "added the rice's zsh setup to ~/.zshrc"
fi
if grep -qs 'starship init' "$HOME/.zshrc"; then
    warn "$HOME/.zshrc runs starship init itself; rice.zsh already does, so that line can go"
fi
if [ ! -e "$HOME/.config/hypr/local.lua" ]; then
    run cp "$repo/hypr/.config/hypr/local.example.lua" "$HOME/.config/hypr/local.lua"
    ok "created ~/.config/hypr/local.lua (set your monitors there)"
fi
# bring your monitors and keyboard layout over from the old hyprland.conf
# (this run's backup, else the newest earlier one)
old_conf=""
for c in "$backup/.config/hypr/hyprland.conf" $(ls -1dr "${backup%/*}"/*/.config/hypr/hyprland.conf 2>/dev/null); do
    [ -f "$c" ] && { old_conf=$c; break; }
done
if [ -n "$old_conf" ]; then
    if [ "$dry" = 1 ]; then
        run "$repo/tools/hypr-migrate" "$old_conf" "$HOME/.config/hypr/local.lua"
    else
        migrated=$("$repo/tools/hypr-migrate" "$old_conf" "$HOME/.config/hypr/local.lua")
        if [ -n "$migrated" ]; then
            ok "copied your monitor and keyboard settings into local.lua:"
            printf '%s\n' "$migrated" | sed 's/^/      /'
        fi
    fi
fi

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "$HOME/.local/bin is not on your PATH; add it in your shell profile"
       export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ── the active rice ─────────────────────────────────────────────────────
rices="$HOME/.config/rices"
step "Choosing the rice"
if [ -z "$rice" ]; then
    if [ -L "$rices/current" ]; then rice=$(basename "$(readlink "$rices/current")"); else rice=nacre; fi
fi
[ -f "$repo/rices/.config/rices/$rice/palette.toml" ] || die "no rice called $rice (try: $(cd "$repo/rices/.config/rices" && ls -d */ | tr -d / | tr '\n' ' '))"
run ln -sfn "$rice" "$rices/current"
ok "$rice"

# ── themes ──────────────────────────────────────────────────────────────
step "Rendering themes"
run rice-render --all --quiet
ok "every rice rendered"
# links every app theme, turns on Firefox's userChrome in each profile it
# finds, points qt6ct/mpv at the rice and applies Spicetify
link_args=(--link --backup "$backup")
[ "$firefox" = 1 ] && link_args+=(--firefox)
run rice-render "${link_args[@]}"

# kitty includes the active rice's colours (and reloads them on SIGUSR1)
kitty_conf="$HOME/.config/kitty/kitty.conf"
include="include ~/.local/share/rice/active/kitty.conf"
old_include="include ~/.config/rices/current/build/kitty.conf"
if grep -qsxF "$old_include" "$kitty_conf"; then
    # the include from before light and dark builds
    run sed -i "s|^$old_include\$|$include|" "$kitty_conf"
    ok "kitty.conf now includes the rice through ~/.local/share/rice/active"
elif ! grep -qsxF "$include" "$kitty_conf"; then
    run mkdir -p "$(dirname "$kitty_conf")"
    if [ "$dry" = 1 ]; then run echo "$include" '>>' "$kitty_conf"; else printf '\n%s\n' "$include" >> "$kitty_conf"; fi
    ok "kitty.conf now includes the rice"
fi

# ── services ────────────────────────────────────────────────────────────
step "Services"
if have systemctl && systemctl --user show-environment >/dev/null 2>&1; then
    # the old time-of-day rice switching is gone; its timer may still be enabled
    run systemctl --user disable --now rice-auto.timer 2>/dev/null || true
    run systemctl --user daemon-reload
    # it only acts once `rice mode auto` is on
    run systemctl --user enable --now rice-mode.timer
    ok "the auto-mode timer is enabled (turn auto mode on with: rice mode auto)"
else
    warn "no systemd user session; skipping the auto-mode timer"
fi

# auto mode's settings: yours to edit, so copied once and never overwritten
mode_toml="$HOME/.config/rice/mode.toml"
if [ ! -e "$mode_toml" ]; then
    run mkdir -p "$(dirname "$mode_toml")"
    run cp "$repo/switcher/.local/share/rice/mode.toml" "$mode_toml"
    ok "wrote $mode_toml (lat and lon are set for auto mode; change them if you move)"
fi

step "Boot and login"
if [ "$system" = 1 ]; then
    sys_args=(--all)
    [ "$yes" = 1 ] && sys_args+=(--yes)
    [ "$dry" = 1 ] && sys_args+=(--dry-run)
    sudo "$repo/system/install" "${sys_args[@]}"
else
    ok "to theme the boot menu, splash and login screen too: sudo $repo/system/install --all"
fi

# ── start it ────────────────────────────────────────────────────────────
step "Starting"
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    run hyprctl reload >/dev/null
    # the shared chooser/overlay shell; base.lua starts it at login, so only needed now
    if have qs && ! qs -c rice ipc call rice ping >/dev/null 2>&1; then run qs -n -c rice -d >/dev/null 2>&1 || true; fi
    run rice session
    ok "live now. tap Super for the launcher, Super+Shift+T for the rice chooser, Super+/ for all keys"
else
    ok "log into Hyprland and it all starts by itself"
fi

[ "$dry" = 1 ] && printf '\n%sdry run: nothing was changed%s\n' "$dim" "$off"
exit 0
