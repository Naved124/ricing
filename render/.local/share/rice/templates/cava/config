# Generated by rice-render for {{ meta.title }}. Linked to ~/.config/cava/config
# (the shells run their own cava with their own settings; this is for cava
# in a terminal). Bars run from the gradient's first stop to its last.
[general]
framerate = 60
bar_width = 2
bar_spacing = 1

[input]
method = pipewire

[color]
gradient = 1
gradient_count = 2
gradient_color_1 = '{{ gradient.stops | first }}'
gradient_color_2 = '{{ gradient.stops | last }}'

[smoothing]
noise_reduction = 70
