# Generated by rice-render for {{ meta.title }}. Sourced by ~/.config/zsh/rice.zsh,
# which reloads it on the next prompt after a rice switch.
# Colours come from the ANSI set: those are contrast-checked against the
# terminal glass, the roles aren't (mint on pearl would vanish).

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='none'
ZSH_HIGHLIGHT_STYLES[command]='fg={{ ansi.color2 }}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={{ ansi.color2 }}'
ZSH_HIGHLIGHT_STYLES[precommand]='fg={{ ansi.color2 }},italic'
ZSH_HIGHLIGHT_STYLES[alias]='fg={{ ansi.color5 }}'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg={{ ansi.color5 }}'
ZSH_HIGHLIGHT_STYLES[function]='fg={{ ansi.color5 }}'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg={{ ansi.color5 }},bold'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{ ansi.color1 }},bold'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg={{ ansi.color8 }}'
ZSH_HIGHLIGHT_STYLES[path]='fg={{ roles.term_fg }},underline'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg={{ roles.term_fg }},underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg={{ ansi.color6 }}'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg={{ ansi.color6 }}'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg={{ ansi.color4 }}'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg={{ ansi.color4 }}'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg={{ ansi.color3 }}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg={{ ansi.color3 }}'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg={{ ansi.color3 }}'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg={{ ansi.color6 }}'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg={{ ansi.color6 }}'
ZSH_HIGHLIGHT_STYLES[assign]='fg={{ ansi.color6 }}'
ZSH_HIGHLIGHT_STYLES[redirection]='fg={{ ansi.color5 }}'
ZSH_HIGHLIGHT_STYLES[comment]='fg={{ ansi.color8 }},italic'
ZSH_HIGHLIGHT_STYLES[bracket-level-1]='fg={{ ansi.color4 }},bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-2]='fg={{ ansi.color5 }},bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-3]='fg={{ ansi.color6 }},bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-4]='fg={{ ansi.color3 }},bold'
ZSH_HIGHLIGHT_STYLES[bracket-error]='fg={{ ansi.color1 }},bold'
ZSH_HIGHLIGHT_STYLES[cursor-matchingbracket]='standout'

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{ ansi.color8 }}'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='fg={{ ansi.color2 }},bold'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg={{ ansi.color1 }},bold'

# the completion menu: group headings and the no-match warning
_rice_head='{{ ansi.color5 }}' _rice_warn='{{ ansi.color1 }}'
zstyle ':completion:*' menu select
zstyle ':completion:*:descriptions' format "%F{$_rice_head}%B── %d%b%f"
zstyle ':completion:*:warnings' format "%F{$_rice_warn}no matches for %d%f"
unset _rice_head _rice_warn
