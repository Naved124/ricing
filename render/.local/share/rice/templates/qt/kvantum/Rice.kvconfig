# Generated by rice-render for {{ meta.title }}. ~/.config/Kvantum/Rice links here.
# Activate once: kvantummanager --set Rice  (and pick "kvantum" as the qt6ct style).
# Recolours Kvantum's built-in SVG; no per-rice artwork is needed.
[%General]
author=rice-render
comment=Generated from {{ meta.name }}/palette.toml
x11drag=menubar_and_primary_toolbar
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=6
tooltip_shadow_depth=4
spread_menuitems=true
scroll_arrows=false
tree_branch_line=true
button_contents_shift=false
respect_DE=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16

[GeneralColors]
window.color={{ roles.bg }}
base.color={{ roles.bg | mix(roles.surface, 0.3) }}
alt.base.color={{ roles.surface }}
button.color={{ roles.surface }}
light.color={{ roles.bg }}
mid.light.color={{ roles.surface }}
dark.color={{ roles.border }}
mid.color={{ roles.overlay }}
highlight.color={{ roles.selection }}
inactive.highlight.color={{ roles.surface }}
text.color={{ roles.fg }}
window.text.color={{ roles.fg }}
button.text.color={{ roles.fg }}
disabled.text.color={{ roles.muted }}
tooltip.text.color={{ roles.fg }}
highlight.text.color={{ roles.fg }}
link.color={{ ansi.color4 }}
link.visited.color={{ ansi.color5 }}
progress.indicator.text.color={{ roles.fg }}
