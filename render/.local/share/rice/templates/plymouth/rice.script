# Generated by rice-render for {{ meta.title }}: Plymouth's boot splash.
# The ground shading top to bottom, the pearl breathing in the middle, a thin
# progress line under it, and a pill for the disk password when one is asked.

Window.SetBackgroundTopColor({{ derived.ground.0 | rgbf }});
Window.SetBackgroundBottomColor({{ derived.ground.1 | rgbf }});

w = Window.GetWidth();
h = Window.GetHeight();
size = Math.Int(Math.Min(w, h) * 0.14);

# ── the pearl ───────────────────────────────────────────────────────────
logo.image = Image("logo.png").Scale(size, size);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Math.Int((w - size) / 2));
logo.sprite.SetY(Math.Int(h * 0.42 - size / 2));
logo.sprite.SetZ(10);

# ── progress: a hairline track and the accent filling it ────────────────
bar.width = Math.Int(size * 1.6);
bar.x = Math.Int((w - bar.width) / 2);
bar.y = Math.Int(h * 0.42 + size / 2 + size * 0.35);
track.sprite = Sprite(Image("track.png").Scale(bar.width, 2));
track.sprite.SetX(bar.x);
track.sprite.SetY(bar.y);
track.sprite.SetOpacity(0.5);
fill.image = Image("bar.png");
fill.sprite = Sprite(fill.image.Scale(1, 2));
fill.sprite.SetX(bar.x);
fill.sprite.SetY(bar.y);
fill.sprite.SetZ(11);

fun progress_cb(duration, progress) {
    width = Math.Int(bar.width * progress);
    if (width < 1) width = 1;
    fill.sprite.SetImage(fill.image.Scale(width, 2));
}
Plymouth.SetBootProgressFunction(progress_cb);

# ── breathing ───────────────────────────────────────────────────────────
t = 0;
fun refresh_cb() {
    t++;
    logo.sprite.SetOpacity(0.78 + 0.22 * Math.Sin(t / 30));
}
Plymouth.SetRefreshFunction(refresh_cb);

# ── disk password: a pill with the prompt above and dots inside ─────────
field.width = Math.Int(size * 2.6);
field.height = Math.Int(size * 0.34);
field.x = Math.Int((w - field.width) / 2);
field.y = Math.Int(h * 0.42 + size / 2 + size * 0.55);
field.sprite = Sprite(Image("field.png").Scale(field.width, field.height));
field.sprite.SetX(field.x);
field.sprite.SetY(field.y);
field.sprite.SetOpacity(0);
prompt.sprite = Sprite();
dots.sprite = Sprite();

fun password_cb(text, bullets) {
    field.sprite.SetOpacity(0.85);
    track.sprite.SetOpacity(0);
    fill.sprite.SetOpacity(0);
    label = Image.Text(text, {{ roles.muted | rgbf }}, 1, "{{ fonts.ui }} 13");
    prompt.sprite.SetImage(label);
    prompt.sprite.SetX(Math.Int((w - label.GetWidth()) / 2));
    prompt.sprite.SetY(field.y - label.GetHeight() - 10);
    stars = "";
    for (i = 0; i < bullets && i < 24; i++) stars = stars + "●";
    shown = Image.Text(stars, {{ roles.fg | rgbf }}, 1, "{{ fonts.ui }} 13");
    dots.sprite.SetImage(shown);
    dots.sprite.SetX(Math.Int((w - shown.GetWidth()) / 2));
    dots.sprite.SetY(Math.Int(field.y + (field.height - shown.GetHeight()) / 2));
    dots.sprite.SetZ(12);
}
Plymouth.SetDisplayPasswordFunction(password_cb);

fun normal_cb() {
    field.sprite.SetOpacity(0);
    prompt.sprite.SetImage(Image.Text(" ", 0, 0, 0));
    dots.sprite.SetImage(Image.Text(" ", 0, 0, 0));
    track.sprite.SetOpacity(0.5);
    fill.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(normal_cb);

# boot messages (fsck and the like), small, near the bottom
msg.sprite = Sprite();
fun message_cb(text) {
    img = Image.Text(text, {{ roles.muted | rgbf }}, 1, "{{ fonts.ui }} 11");
    msg.sprite.SetImage(img);
    msg.sprite.SetX(Math.Int((w - img.GetWidth()) / 2));
    msg.sprite.SetY(Math.Int(h * 0.9));
}
Plymouth.SetMessageFunction(message_cb);
