// Generated by rice-render for {{ meta.title }}. Linked to ~/.config/fastfetch/config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "{{ derived.build_dir }}/fastfetch/logo.png",
    "width": 22,
    "height": 10,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "blue" },
    "key": { "width": 10 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "shell",    "key": "shell" },
    { "type": "packages", "key": "pkgs" },
    { "type": "memory",   "key": "mem" },
    { "type": "uptime",   "key": "up" },
    { "type": "custom",   "key": "rice", "format": "{{ meta.title }}" },
    "break",
    "colors"
  ]
}
