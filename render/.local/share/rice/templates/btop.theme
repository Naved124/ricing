# Generated by rice-render for {{ meta.title }}. Linked to ~/.config/btop/themes/rice.theme.
theme[main_bg]="{{ roles.bg }}"
theme[main_fg]="{{ roles.fg }}"
theme[title]="{{ roles.fg }}"
theme[hi_fg]="{{ ansi.color5 }}"
theme[selected_bg]="{{ roles.selection }}"
theme[selected_fg]="{{ roles.fg }}"
theme[inactive_fg]="{{ roles.muted }}"
theme[graph_text]="{{ roles.muted }}"
theme[meter_bg]="{{ roles.surface }}"
theme[proc_misc]="{{ ansi.color4 }}"
theme[cpu_box]="{{ roles.border }}"
theme[mem_box]="{{ roles.border }}"
theme[net_box]="{{ roles.border }}"
theme[proc_box]="{{ roles.border }}"
theme[div_line]="{{ roles.border }}"
theme[temp_start]="{{ ansi.color6 }}"
theme[temp_mid]="{{ ansi.color3 }}"
theme[temp_end]="{{ ansi.color1 }}"
theme[cpu_start]="{{ gradient.stops | first | darken(0.15) }}"
theme[cpu_mid]="{{ ansi.color5 }}"
theme[cpu_end]="{{ gradient.stops | last | darken(0.25) }}"
theme[free_start]="{{ ansi.color2 }}"
theme[free_mid]="{{ ansi.color2 }}"
theme[free_end]="{{ ansi.color10 }}"
theme[cached_start]="{{ ansi.color4 }}"
theme[cached_mid]="{{ ansi.color4 }}"
theme[cached_end]="{{ ansi.color12 }}"
theme[available_start]="{{ ansi.color3 }}"
theme[available_mid]="{{ ansi.color3 }}"
theme[available_end]="{{ ansi.color11 }}"
theme[used_start]="{{ ansi.color1 }}"
theme[used_mid]="{{ ansi.color1 }}"
theme[used_end]="{{ ansi.color9 }}"
theme[download_start]="{{ ansi.color6 }}"
theme[download_mid]="{{ ansi.color4 }}"
theme[download_end]="{{ ansi.color5 }}"
theme[upload_start]="{{ ansi.color3 }}"
theme[upload_mid]="{{ ansi.color1 }}"
theme[upload_end]="{{ ansi.color5 }}"
theme[process_start]="{{ ansi.color4 }}"
theme[process_mid]="{{ ansi.color5 }}"
theme[process_end]="{{ ansi.color1 }}"
