#!/usr/bin/env bash
# rice — switch the whole desktop between rices.
#
#   rice <name>          switch to a rice (freeze → swap → reload → dissolve)
#   rice next | prev     cycle through rices in alphabetical order
#   rice list            list rices, marking the active one
#   rice current         print the active rice
#   rice get <key>       read a value from the active palette, e.g. roles.accent
#   rice mode light|dark|toggle [--instant]
#                        switch every rice between light and dark, live (no reload);
#                        --instant skips the transition. The mode stays across rice switches;
#                        a rice with one mode (Abyss: [meta] modes = ["dark"]) keeps its look
#   rice mode auto [off] follow the sun (~/.config/rice/mode.toml), or stop; a manual
#                        light/dark holds until the next sunrise or sunset
#   rice mode tick       what the timer runs: apply the sun's mode unless held
#   rice mode status [-v] the mode, where it came from, and the next switch
#   rice choose          toggle the chooser (Super+Shift+T)
#   rice reapply         run every apply step again for the active rice (restarts its shell)
#   rice recolour        render the active rice again and recolour the desktop live, the
#                        way a mode change does (satsuei-wall set runs it for Satsuei)
#   rice session         start the active rice at login (no freeze, no transition)
#   rice lock            lock the screen with the rice's lock (its shell, or hyprlock)
#   rice grain on|off|toggle|status
#                        the rice's screen shader (Paper's paper grain); off is
#                        remembered, and leaves fullscreen games direct scanout
#   rice logout          end the session: uwsm stop, else hyprshutdown, else
#                        Hyprland's exit, else loginctl terminate-session
#   rice system          re-theme the boot menu, splash and login screen to the
#                        active rice (sudo system/install --refresh)
#   rice json            everything the chooser needs, as JSON
#   rice on-battery      exit 0 when running on battery (for hypridle)
#
# Every step after the symlink swap is optional: if a tool is not installed
# or the rice does not ship the file for it, that step is skipped.

set -euo pipefail

RICE_DIR="${RICE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/rices}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rice"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/rice"
# the active rice's build in the active mode; every app's config links through it
ACTIVE="${XDG_DATA_HOME:-$HOME/.local/share}/rice/active"
SHARED_SHELL="rice"            # qs -c rice: the chooser and the switch overlay

mkdir -p "$STATE_DIR" "$RUN_DIR" "${ACTIVE%/*}"

log()  { printf '\033[2mrice:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31mrice:\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# toml_get FILE SECTION KEY — read `key = value` from `[section]` of a flat TOML
# file. Strips quotes and trailing comments. Prints nothing if missing.
toml_get() {
    awk -v want_sec="$2" -v want_key="$3" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        /^[[:space:]]*\[/ {
            sec = $0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", sec); next
        }
        sec == want_sec {
            line = $0
            eq = index(line, "="); if (!eq) next
            key = substr(line, 1, eq - 1); gsub(/[[:space:]]/, "", key)
            if (key != want_key) next
            val = substr(line, eq + 1)
            sub(/^[[:space:]]+/, "", val)
            if (val ~ /^"/) { sub(/^"/, "", val); sub(/".*$/, "", val) }
            else            { sub(/[[:space:]]*#.*$/, "", val); sub(/[[:space:]]+$/, "", val) }
            print val; exit
        }' "$1"
}

palette() { toml_get "$RICE_DIR/$1/palette.toml" "$2" "$3"; }

# light or dark, from ~/.local/state/rice/mode (light when unset)
mode() {
    local m
    m="$(cat "$STATE_DIR/mode" 2>/dev/null || true)"
    [[ "$m" == dark ]] && echo dark || echo light
}

# fixed_mode RICE: the one mode a rice always wears ([meta] modes = ["dark"]),
# or nothing when it has both
fixed_mode() {
    local m
    m="$(palette "$1" meta modes | tr -d '[]" ')"
    [[ -n "$m" && "$m" != *,* ]] && printf '%s\n' "$m"
    return 0
}

# look RICE KEY: a key from the rice's [modes.<mode>.meta] (GTK theme, icons,
# screen shader); a rice without dark tables wears its light ones, and a
# one-mode rice its one mode
look() {
    local m
    m="$(fixed_mode "$1")"
    [[ -n "$m" ]] || m="$(mode)"
    grep -q "^\[modes\.$m\." "$RICE_DIR/$1/palette.toml" || m=light
    palette "$1" "modes.$m.meta" "$2"
}

rices() {
    local d
    for d in "$RICE_DIR"/*/; do
        d="${d%/}"
        [[ -L "$d" ]] && continue                 # skip `current`
        [[ -f "$d/palette.toml" ]] && basename "$d"
    done
}

current() {
    [[ -L "$RICE_DIR/current" ]] && basename "$(readlink "$RICE_DIR/current")"
}

# ── the shared shell (quickshell/.config/quickshell/rice) ───────────────────
rice_ipc()     { have qs && qs -c "$SHARED_SHELL" ipc call rice "$@" >/dev/null 2>&1; }
rice_running() { have qs && [[ "$(qs -c "$SHARED_SHELL" ipc call rice ping 2>/dev/null)" == pong ]]; }

ensure_rice_shell() {
    have qs || return 1
    rice_running && return 0
    qs -n -c "$SHARED_SHELL" -d >/dev/null 2>&1 9>&- || true
    for _ in $(seq 60); do rice_running && return 0; sleep 0.05; done
    return 1
}

# ── freeze: screenshot every output and pin it above everything ─────────────
# fails (and pins nothing) when there's no grim, no shared shell, or a shot failed
freeze() {
    have grim || return 1
    rice_running || return 1
    local dir="$RUN_DIR/freeze" out ok=0
    rm -rf "$dir"; mkdir -p "$dir"
    if have hyprctl && have jq; then
        local pids=()
        for out in $(hyprctl monitors -j | jq -r '.[].name'); do
            grim -l 0 -o "$out" "$dir/$out.png" & pids+=("$!")
        done
        for out in "${pids[@]}"; do wait "$out" || ok=1; done
    else
        grim -l 0 "$dir/all.png" || ok=1
    fi
    (( ok == 0 )) || return 1
    rice_ipc freeze "$dir" || return 1
    sleep "${RICE_FREEZE_SETTLE:-0.12}"     # let the frames reach the screen
}

# ── dissolve: let the incoming rice reveal itself ────────────────────────────
# dissolve TO FROM: the shell picks the outgoing rice's way out if it has one
# ([meta] transition_out: Abyss drains away), else the incoming rice's
# transition.frag.qsb; with animations off or a battery under 20% it fades
dissolve() {
    local how=full
    if reduced_motion || low_battery; then how=fade; fi
    rice_ipc dissolve "$1" "${2:-}" "$how" || true
}

# ── apply: everything that has to happen once `current` points somewhere new ─
apply_hypr() {
    have hyprctl || return 0
    hyprctl reload >/dev/null
}

# the cursor: one for every rice, by the light (rice-render's CURSORS):
# Bibata Modern Classic by day, Ice at night, in a dark-only rice and before
# any mode is chosen; a rice with [meta] cursor wears its own in both.
# It's set only when it changes (the last one is in $STATE_DIR/cursor), so
# switching between rices in the same mode leaves it be;
# login (RICE_FORCE) always sets it.
cursor_name() {
    local m
    # a rice's own cursor for both modes ([meta] cursor: Golden Gate's Apple one)
    m="$(palette "$1" meta cursor)"
    if [[ -n "$m" ]]; then echo "$m"; return; fi
    m="$(fixed_mode "$1")"
    if [[ -z "$m" ]]; then
        if [[ -s "$STATE_DIR/mode" ]]; then m="$(mode)"; else m=dark; fi
    fi
    [[ "$m" == light ]] && echo Bibata-Modern-Classic || echo Bibata-Modern-Ice
}
apply_cursor() {
    local want size
    want="$(cursor_name "$1")"
    size="$(palette "$1" gtk cursor_size)"; size="${size:-24}"
    if [[ "$want $size" == "$(cat "$STATE_DIR/cursor" 2>/dev/null || true)" && "${RICE_FORCE:-0}" != 1 ]]; then
        return 0
    fi
    if have hyprctl; then hyprctl setcursor "$want" "$size" >/dev/null || true; fi
    if have gsettings; then
        gsettings set org.gnome.desktop.interface cursor-theme "$want" || true
        gsettings set org.gnome.desktop.interface cursor-size "$size" || true
    fi
    # XWayland and apps that read neither: the default cursor theme
    mkdir -p "$HOME/.icons/default"
    printf '[Icon Theme]\nInherits=%s\n' "$want" > "$HOME/.icons/default/index.theme"
    write_state cursor "$want $size"
}

# Hyprland's screen shader, set explicitly on every switch: the rice's own
# (meta.screen_shader, relative to its folder) unless `rice grain off` is in
# force, else none. `hyprctl reload` already resets every option, but a
# shader left behind would cost every other rice direct scanout, so this
# doesn't rely on it.
screen_shader_for() {
    local s
    s="$(look "$1" screen_shader)"
    [[ -n "$s" && ! -e "$STATE_DIR/grain-off" && -f "$RICE_DIR/$1/$s" ]] || return 0
    printf '%s\n' "$RICE_DIR/$1/$s"
}

apply_screen_shader() {
    have hyprctl || return 0
    local want
    want="$(screen_shader_for "$1")"
    hyprctl eval "hl.config({ decoration = { screen_shader = \"$want\" } })" >/dev/null
}

grain() {
    local cur
    cur="$(current || true)"
    case "${1:-status}" in
        on)  rm -f "$STATE_DIR/grain-off" ;;
        off) : > "$STATE_DIR/grain-off" ;;
        toggle)
            if [[ -e "$STATE_DIR/grain-off" ]]; then grain on; else grain off; fi
            return ;;
        status)
            if [[ -e "$STATE_DIR/grain-off" ]]; then echo off; else echo on; fi
            return ;;
        *) die "usage: rice grain on|off|toggle|status" ;;
    esac
    [[ -n "$cur" ]] && apply_screen_shader "$cur"
    return 0
}

# render every theme file for the rice from its palette.toml
render() {
    have rice-render || return 0
    rice-render -q "$1"
}

# pids of the running instances of a Quickshell config. `qs list` prints its
# "No running instances" note on stdout too, so only its JSON form says.
shell_pids() {
    qs list -c "$1" -j 2>/dev/null | jq -r '.[]?.pid // empty' 2>/dev/null || true
}

# stop every instance of a config (`qs kill` refuses when there are several)
# and wait until they're gone, so a fresh `qs -n` isn't turned away by one
# still exiting
stop_shell() {
    local pids i
    mapfile -t pids < <(shell_pids "$1")
    (( ${#pids[@]} )) || return 0
    kill "${pids[@]}" 2>/dev/null || true
    for (( i = 0; i < 30; i++ )); do
        [[ -z "$(shell_pids "$1")" ]] && return 0
        sleep 0.1
    done
    kill -KILL "${pids[@]}" 2>/dev/null || true
    sleep 0.2
}

# swap the per-rice Quickshell config: stop the old one, start the new one
apply_shell() {
    local to="$1" from="${2:-}" new old
    have qs || return 0
    new="$(palette "$to" meta shell)"
    old="$([[ -n "$from" ]] && palette "$from" meta shell || true)"
    if [[ -n "$old" && "$old" != "$new" ]]; then
        stop_shell "$old"
    fi
    [[ -n "$new" ]] || return 0
    if [[ "$old" == "$new" && -n "$(shell_pids "$new")" ]]; then
        # already running (it reloads itself), but `rice reapply` restarts it: a
        # shell whose config failed to load stays alive, drawing nothing
        [[ "${RICE_FORCE:-0}" == 1 ]] || return 0
        stop_shell "$new"
    fi
    qs -n -c "$new" -d >/dev/null 2>&1 9>&-
}

# the shell draws the wallpaper (meta.wallpaper = "shell"), or a wallpaper/
# folder does: a video through mpvpaper, else an image through swww
apply_wallpaper() {
    local dir="$RICE_DIR/current/wallpaper" file
    if [[ "$(palette "$1" meta wallpaper)" == shell ]]; then
        pkill -x mpvpaper 2>/dev/null || true
        have swww && swww kill >/dev/null 2>&1 || true
        return 0
    fi
    [[ -d "$dir" ]] || return 0
    file="$(find -L "$dir" -maxdepth 1 -type f \
        \( -name '*.mp4' -o -name '*.webm' -o -name '*.mkv' \) | sort | head -n1)"
    if [[ -n "$file" ]] && have mpvpaper; then
        local shader opts="loop no-audio panscan=1.0"
        shader="$(find -L "$dir" -maxdepth 1 -name '*.glsl' | sort | head -n1)"
        [[ -n "$shader" ]] && opts+=" glsl-shaders=$shader"
        pkill -x mpvpaper || true
        have swww && swww kill >/dev/null 2>&1 || true
        setsid -f mpvpaper -o "$opts" '*' "$file" >/dev/null 2>&1 9>&-
        return 0
    fi
    file="$(find -L "$dir" -maxdepth 1 -type f \
        \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.webp' -o -name '*.gif' \) \
        | sort | head -n1)"
    if [[ -n "$file" ]] && have swww; then
        pkill -x mpvpaper || true
        swww query >/dev/null 2>&1 || { setsid -f swww-daemon >/dev/null 2>&1 9>&-; sleep 0.3; }
        # the overlay covers the change, so swap instantly
        swww img "$file" --transition-type none >/dev/null 2>&1
    fi
}

apply_kitty() {
    # kitty re-reads kitty.conf (which includes current/kitty.conf) on SIGUSR1
    pkill -USR1 -x kitty 2>/dev/null || true
}

apply_nvim() {
    have nvim || return 0
    local scheme sock
    scheme="$(palette "$1" nvim colorscheme)"
    [[ -n "$scheme" ]] || return 0
    for sock in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*.0 /tmp/nvim.*/0; do
        [[ -S "$sock" ]] || continue
        timeout 1 nvim --server "$sock" --remote-expr \
            "execute('silent! colorscheme $scheme')" >/dev/null 2>&1 || true
    done
}

# 600 → SemiBold: the style name fontconfig and GTK understand
weight_name() {
    case "${1:-400}" in
        1??) echo Thin ;; 2??) echo ExtraLight ;; 3??) echo Light ;;
        4??) echo Regular ;; 5??) echo Medium ;; 6??) echo SemiBold ;;
        7??) echo Bold ;; 8??) echo ExtraBold ;; *) echo Black ;;
    esac
}

apply_gtk() {
    have gsettings || return 0
    local s=org.gnome.desktop.interface v
    v="$(look "$1" gtk_theme)";          [[ -n "$v" ]] && gsettings set $s gtk-theme "$v"
    v="$(look "$1" icon_theme)";         [[ -n "$v" ]] && gsettings set $s icon-theme "$v"
    v="$(look "$1" color_scheme)";       [[ -n "$v" ]] && gsettings set $s color-scheme "$v"
    local ui mono size msize style
    # apps' text size: app_size, or the shell's ui_size when a rice doesn't set one
    ui="$(palette "$1" fonts ui)"; size="$(palette "$1" fonts app_size)"
    [[ -n "$size" ]] || size="$(palette "$1" fonts ui_size)"
    mono="$(palette "$1" fonts mono)"; msize="$(palette "$1" fonts mono_size)"
    style="$(weight_name "$(palette "$1" fonts weight)")"
    [[ -n "$ui" ]] && gsettings set $s font-name "$ui $style ${size:-11}"
    [[ -n "$ui" ]] && gsettings set $s document-font-name "$ui $style ${size:-11}"
    [[ -n "$mono" ]] && gsettings set $s monospace-font-name "$mono $style ${msize:-12}"
    return 0
}

# who shows notifications: the rice's shell (meta.notifications = "shell"),
# or swaync. Only one daemon can own the bus name, so stop the other.
apply_notifications() {
    if [[ "$(palette "$1" meta notifications)" == shell ]]; then
        # the shell is the daemon; only one can own org.freedesktop.Notifications
        local d
        for d in swaync mako dunst; do pkill -x "$d" 2>/dev/null || true; done
        return 0
    fi
    have swaync || return 0
    if pgrep -x swaync >/dev/null; then
        swaync-client --reload-config >/dev/null 2>&1 || true
        swaync-client --reload-css    >/dev/null 2>&1 || true
    else
        setsid -f swaync >/dev/null 2>&1 9>&-
    fi
}

# apps that need a nudge to pick up the new files: Spotify (Spicetify) gets
# the colours on its next start; restarting it here would stop the music
apply_apps() {
    if have spicetify && [[ "$(spicetify config current_theme 2>/dev/null)" == Rice ]]; then
        spicetify refresh -n >/dev/null 2>&1 || true
    fi
    return 0
}

apply_hook() {
    local hook="$RICE_DIR/current/hooks/post-switch"
    [[ -x "$hook" ]] && "$hook" "$1" || true
}

# leave_hook FROM TO: the rice being left undoes what only it does (Golden
# Gate unloads its Hyprland plugins and puts the user's Qt and GTK settings
# back), before the new rice applies its own
leave_hook() {
    [[ -n "$1" ]] || return 0
    local hook="$RICE_DIR/$1/hooks/leave"
    [[ -x "$hook" ]] && "$hook" "$2" || true
}

# enter_hook TO FROM: before the incoming rice applies anything, what it has
# to do first (Golden Gate saves the user's own GTK, Qt and cursor settings,
# to give them back when it's left)
enter_hook() {
    local hook="$RICE_DIR/$1/hooks/enter"
    [[ -x "$hook" ]] && "$hook" "${2:-}" || true
}

# mode_hook RICE MODE: after `rice mode`, what the rice changes itself
# (Golden Gate: Kvantum's light or dark theme, the glass's theme)
mode_hook() {
    local hook="$RICE_DIR/$1/hooks/post-mode"
    [[ -x "$hook" ]] && "$hook" "$2" || true
}

# A broken step must never leave the screen frozen, so failures are logged
# and the switch carries on to the dissolve.
step() { "$@" || log "$1 failed (exit $?), continuing"; }

# everything that makes the desktop look like the rice now in `current`
apply_all() {
    step apply_hypr "$1"
    step apply_cursor "$1"
    step apply_screen_shader "$1"
    step apply_gtk "$1"
    step apply_kitty
    step apply_nvim "$1"
    step apply_notifications "$1"
    step apply_wallpaper "$1"
    step apply_shell "$1" "${2:-}"
    step apply_apps
    step apply_hook "$1"
}

swap_link() {
    # atomic: build the new link beside the old one, then rename over it
    ln -sfn "$1" "$RICE_DIR/.current.tmp"
    mv -T "$RICE_DIR/.current.tmp" "$RICE_DIR/current"
    point_active
}

# active → current/build/<mode>, the same way; it goes through `current`, so
# a rice switch alone doesn't have to touch it
point_active() {
    local want
    want="$RICE_DIR/current/build/$(mode)"
    [[ "$(readlink "$ACTIVE" 2>/dev/null)" == "$want" ]] && return 0
    ln -sfn "$want" "${ACTIVE%/*}/.active.tmp"
    mv -T "${ACTIVE%/*}/.active.tmp" "$ACTIVE"
}

# one switch (of rice or mode) at a time; a second press just waits its turn.
# fd 9 holds the lock: everything started here that outlives the switch
# (shells, daemons) gets `9>&-`, or the next `rice` would wait for it to exit
take_lock() {
    exec 9>"$RUN_DIR/lock"
    flock -w "${RICE_LOCK_WAIT:-20}" 9 || die "another switch still holds $RUN_DIR/lock (see: fuser -v $RUN_DIR/lock; deleting the file frees it)"
}

switch_to() {
    local target="$1" from
    [[ -f "$RICE_DIR/$target/palette.toml" ]] || die "no such rice: $target (try: rice list)"
    from="$(current || true)"
    if [[ "$target" == "$from" && "${RICE_FORCE:-0}" != 1 ]]; then
        log "$target is already active"; return 0
    fi

    take_lock

    log "${from:-none} → $target"
    # themes first, while the old desktop is still live: the freeze stays short
    step render "$target"
    ensure_rice_shell || true
    freeze || true

    if [[ "$from" != "$target" ]]; then
        step leave_hook "$from" "$target"
        step enter_hook "$target" "$from"
    fi
    swap_link "$target"
    apply_all "$target" "$from"
    rice_ipc reload || true           # the chooser picks up the new current rice

    sleep "${RICE_SETTLE:-0.45}"      # give the new shell and wallpaper a frame to draw
    dissolve "$target" "$from"

    printf '%s\n' "$target" > "$STATE_DIR/last"
}

cycle() {
    local list cur i n
    mapfile -t list < <(rices)
    n=${#list[@]}; (( n )) || die "no rices in $RICE_DIR"
    cur="$(current || true)"
    for i in "${!list[@]}"; do [[ "${list[$i]}" == "$cur" ]] && break; done
    [[ "${list[$i]:-}" == "$cur" ]] || i=-1
    switch_to "${list[$(( (i + $1 + n) % n ))]}"
}

# ── auto mode ────────────────────────────────────────────────────────────────
# Schedule lives in $RICE_DIR/auto.conf as "HH:MM rice" lines; the last entry
# whose time has passed wins (wrapping round midnight).
choose() {
    have qs || die "quickshell (qs) is not installed"
    ensure_rice_shell || die "couldn't start the rice shell (qs -c $SHARED_SHELL)"
    rice_ipc toggle
}

# at login: no freeze and no transition, just bring the active rice up
session() {
    local cur
    cur="$(current || true)"
    if [[ -z "$cur" ]]; then
        cur="$(rices | head -n1)"
        [[ -n "$cur" ]] || die "no rices in $RICE_DIR"
        swap_link "$cur"
    fi
    point_active
    step mode_cmd tick --instant          # before the shells start, so they start in it
    step render "$cur"
    step enter_hook "$cur"
    step apply_gtk "$cur"
    RICE_FORCE=1 step apply_cursor "$cur"
    step apply_notifications "$cur"
    step apply_wallpaper "$cur"
    step apply_shell "$cur"
    step apply_hook "$cur"
}

lock() {
    local cur shell
    cur="$(current || true)"
    if [[ -n "$cur" && "$(palette "$cur" meta lock)" == shell ]]; then
        shell="$(palette "$cur" meta shell)"
        if [[ -n "$shell" ]] && have qs && qs -c "$shell" ipc call lock lock >/dev/null 2>&1; then
            return 0
        fi
    fi
    # hyprlock, unless one is already up
    have hyprlock || die "no lock screen: the rice's shell isn't running and hyprlock isn't installed"
    pidof hyprlock >/dev/null || setsid -f hyprlock >/dev/null 2>&1
}

# Leave the session, gracefully when possible, and make sure it really ends:
# a login manager (greetd, SDDM) only comes back once the session is gone.
logout() {
    local wait=3
    if have uwsm && uwsm check is-active >/dev/null 2>&1; then
        exec uwsm stop
    fi
    if have hyprshutdown; then
        # asks every app to close, then quits Hyprland
        setsid -f hyprshutdown -t 'Logging out…' >/dev/null 2>&1
        wait=20     # apps may stop to ask about unsaved work
    elif have hyprctl; then
        hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || hyprctl dispatch exit >/dev/null 2>&1 || true
    fi
    # still here after a moment? end the login session itself
    sleep "${RICE_LOGOUT_WAIT:-$wait}"
    if pgrep -x Hyprland >/dev/null 2>&1 && [[ -n "${XDG_SESSION_ID:-}" ]]; then
        log "Hyprland didn't exit; ending session $XDG_SESSION_ID"
        loginctl terminate-session "$XDG_SESSION_ID"
    fi
}

# Boot menu, splash and login screen live in /boot and /etc, so re-theming
# them after a switch needs root: this asks for it rather than doing it quietly.
system_theme() {
    local repo
    repo="$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)"
    [[ -x "$repo/system/install" ]] || die "can't find system/install next to this script ($repo)"
    exec sudo "$repo/system/install" --refresh "$@"
}

on_battery() {
    local s
    for s in /sys/class/power_supply/*/online; do
        [[ -f "$s" ]] || continue
        [[ "$(cat "$s")" == 1 ]] && return 1     # mains connected
    done
    compgen -G '/sys/class/power_supply/BAT*' >/dev/null    # a battery, and no mains
}

# ── light and dark ───────────────────────────────────────────────────────
# `rice mode` changes the light without a reload: every rice is rendered in
# both modes, so it only re-points `active`, hands Hyprland the mode's
# hypr-mode.lua, and tells the desktop and the running apps.

now_ms() { date +%s%3N; }

# write_state NAME VALUE: atomically, so nothing ever reads half a file
write_state() {
    local tmp
    tmp="$(mktemp "$STATE_DIR/.$1.XXXXXX")"
    printf '%s\n' "$2" > "$tmp"
    mv -f "$tmp" "$STATE_DIR/$1"
}

# skip the transition when animations are off, or on a battery under 20%
reduced_motion() {
    [[ "${RICE_REDUCED_MOTION:-0}" == 1 ]] && return 0
    have gsettings && [[ "$(gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null)" == false ]]
}
low_battery() {
    local b
    for b in "${RICE_POWER_SUPPLY:-/sys/class/power_supply}"/BAT*; do
        [[ -r "$b/capacity" && "$(cat "$b/status" 2>/dev/null)" == Discharging ]] || continue
        (( $(cat "$b/capacity") < 20 )) && return 0
    done
    return 1
}

# Hyprland: the mode's colours, shadows and screen shader in one eval
apply_mode_hypr() {
    have hyprctl || return 0
    [[ -f "$ACTIVE/hypr-mode.lua" ]] || return 0
    local out
    # Hyprland reads the file itself: passed as text, its first line (a `--`
    # comment) was taken for one of hyprctl's flags and nothing was applied.
    # Say why when Hyprland refuses it (its answer is otherwise thrown away)
    if ! out="$(hyprctl eval "dofile([[$ACTIVE/hypr-mode.lua]])" 2>&1)"; then
        log "hyprctl eval: ${out:-no answer}"
        return 1
    fi
}

# GTK and portal-aware apps (Firefox, libadwaita, kitty's auto themes)
apply_mode_gtk() {
    have gsettings || return 0
    local s=org.gnome.desktop.interface v
    v="$(look "$1" color_scheme)"; [[ -n "$v" ]] && gsettings set $s color-scheme "$v"
    v="$(look "$1" gtk_theme)";    [[ -n "$v" ]] && gsettings set $s gtk-theme "$v"
    v="$(look "$1" icon_theme)";   [[ -n "$v" ]] && gsettings set $s icon-theme "$v"
    return 0
}

# apps that re-read their theme on a signal; Spotify takes its time, so it
# goes in the background
apply_mode_apps() {
    pkill -USR1 -x kitty 2>/dev/null || true
    pkill -USR1 -x cava 2>/dev/null || true
    apply_nvim "$1"
    if have spicetify && [[ "$(spicetify config current_theme 2>/dev/null)" == Rice ]]; then
        { spicetify config color_scheme "rice-$2" && spicetify refresh -n; } >/dev/null 2>&1 9>&- &
    fi
    return 0
}

# mode_ipc HOW MODE [MS]: tell the rice's shell and the shared shell
# (jump: under the overlay; fade: crossfade with no overlay)
mode_ipc() {
    have qs || return 0
    local shell
    shell="$(palette "$(current)" meta shell)"
    for s in $shell "$SHARED_SHELL"; do
        qs -c "$s" ipc call mode "$@" >/dev/null 2>&1 || true
    done
}

# the rice's sound for a mode change (Paper's pull-chain click), when
# ~/.config/rice/mode.toml says sound = true
mode_sound() {
    local f
    f="$(palette "$1" meta mode_sound)"
    [[ -n "$f" && -f "$RICE_DIR/$1/$f" ]] && have pw-play || return 0
    grep -Eq '^[[:space:]]*sound[[:space:]]*=[[:space:]]*true' "${XDG_CONFIG_HOME:-$HOME/.config}/rice/mode.toml" 2>/dev/null || return 0
    pw-play "$RICE_DIR/$1/$f" >/dev/null 2>&1 9>&- &
}

# a one-mode rice (Abyss) under `rice mode`: the choice is remembered for the
# other rices, but nothing on screen changes; a manual choice gets a quiet
# toast from the rice's shell ("Abyss is always dark")
mode_fixed() {
    local cur="$1" target="$2" source="$3" fixed="$4" shell title
    take_lock
    write_state mode "$target"
    write_state mode-source "$source"
    point_active                         # build/<other mode> links to its one build
    step mode_ipc jump "$target"         # the chooser follows; the rice's Mode stays put
    shell="$(palette "$cur" meta shell)"
    title="$(palette "$cur" meta title)"
    if [[ "$source" == manual && -n "$shell" ]] && have qs; then
        qs -c "$shell" ipc call shell toast "$fixed" "${title:-$cur} is always $fixed" >/dev/null 2>&1 || true
    fi
    log "$target (${title:-$cur} stays $fixed)"
}

# mode_set MODE SOURCE INSTANT
mode_set() {
    local target="$1" source="$2" instant="$3" cur how=(jump "$1") frozen=0 t0 fixed
    cur="$(current)" || die "no active rice"
    if [[ "$target" == "$(mode)" && "${RICE_FORCE:-0}" != 1 ]]; then
        # nothing chosen yet reads as light, but wears the night's cursor:
        # choosing light now writes it down and brings the day's
        if [[ ! -s "$STATE_DIR/mode" ]]; then
            write_state mode "$target"
            step apply_cursor "$cur"
        fi
        write_state mode-source "$source"
        log "already $target"; return 0
    fi
    fixed="$(fixed_mode "$cur")"
    if [[ -n "$fixed" ]]; then
        mode_fixed "$cur" "$target" "$source" "$fixed"
        return 0
    fi
    take_lock
    [[ -d "$RICE_DIR/$cur/build/$target" ]] || step render "$cur"

    if [[ "$instant" == 1 ]]; then
        :                                    # straight there
    elif reduced_motion || low_battery; then
        how=(fade "$target" 200)
    else
        ensure_rice_shell || true
        if freeze; then frozen=1; else how=(fade "$target" 200); fi
    fi

    t0="$(now_ms)"
    [[ "$instant" == 1 ]] || mode_sound "$cur"
    write_state mode "$target"
    write_state mode-source "$source"
    point_active
    step apply_mode_hypr
    step apply_mode_gtk "$cur"
    step apply_cursor "$cur"
    step apply_mode_apps "$cur" "$target"
    step mode_hook "$cur" "$target"
    step mode_ipc "${how[@]}"
    printf '%s\n' "$(( $(now_ms) - t0 ))" > "$RUN_DIR/mode-timing"

    if (( frozen )); then
        sleep "${RICE_SETTLE:-0.45}"         # a frame for the shells to redraw
        rice_ipc reveal "$target" || true
    fi
    log "$target"
}

# recolour: the active rice's palette changed underneath it (Satsuei's comes
# from the wallpaper), so render it and push the colours out the way a mode
# change does, with no freeze and no reload. GTK re-reads its gtk.css only on
# a theme change, so the theme is nudged away and back.
recolour() {
    local cur theme
    cur="$(current)" || die "no active rice"
    take_lock
    step render "$cur"
    step apply_mode_hypr
    if have gsettings; then
        theme="$(look "$cur" gtk_theme)"
        if [[ -n "$theme" ]]; then
            gsettings set org.gnome.desktop.interface gtk-theme Adwaita || true
            gsettings set org.gnome.desktop.interface gtk-theme "$theme" || true
        fi
    fi
    step apply_mode_apps "$cur" "$(mode)"
    rice_ipc reload || true
    log "$cur recoloured"
}

# ── auto mode: the sun's light and dark ──────────────────────────────────
# rice-sun (beside this script) works sunrise and sunset out offline from
# ~/.config/rice/mode.toml and prints JSON; RICE_NOW stands in for the clock.
sun() { "${RICE_SUN:-$(dirname "$(readlink -f "$0")")/rice-sun}"; }
auto_on() { [[ -e "$STATE_DIR/mode-auto" ]]; }
now_s() { if [[ -n "${RICE_NOW:-}" ]]; then date -d "$RICE_NOW" +%s; else date +%s; fi; }
# the epoch a manual choice holds until (the next boundary), if one is in force
held_until() {
    local until
    until="$(cat "$STATE_DIR/mode-hold-until" 2>/dev/null)" || return 1
    [[ "$until" =~ ^[0-9]+$ ]] && (( until > $(now_s) )) && printf '%s\n' "$until"
}

# a manual light/dark while auto is on: keep it until the sun's next switch
hold() {
    auto_on || return 0
    local next
    next="$(sun 2>/dev/null | jq -r '.next_epoch // empty')" || return 0
    [[ -n "$next" ]] && write_state mode-hold-until "$next"
    return 0
}

mode_tick() {
    auto_on || return 0
    local out
    out="$(sun 2>/dev/null)" || return 0       # no location yet: nothing to follow
    held_until >/dev/null && return 0
    rm -f "$STATE_DIR/mode-hold-until"
    mode_set "$(jq -r .mode <<<"$out")" auto "$1"
}

mode_auto() {
    local out
    case "${1:-on}" in
        on)
            out="$(sun)" || exit 2              # rice-sun says what's missing
            touch "$STATE_DIR/mode-auto"
            rm -f "$STATE_DIR/mode-hold-until"
            mode_set "$(jq -r .mode <<<"$out")" auto "$2" ;;
        off)
            rm -f "$STATE_DIR/mode-auto" "$STATE_DIR/mode-hold-until"
            write_state mode-source manual
            log "auto mode off; staying $(mode)" ;;
        *) die "usage: rice mode auto [off]" ;;
    esac
}

# "light at 06:41", or nothing when auto is off or has no location
next_switch() {
    auto_on || return 0
    local until out
    if until="$(held_until)"; then
        printf 'held until %s (then auto)\n' "$(date -d "@$until" +%H:%M)"
    elif out="$(sun 2>/dev/null)"; then
        jq -r '"\(.next_mode) at \(.next_hhmm)"' <<<"$out"
    else
        echo "auto: check lat and lon in ~/.config/rice/mode.toml"
    fi
}

mode_status() {
    local next
    next="$(next_switch)"
    if ! auto_on; then
        printf '%s · manual\n' "$(mode)"
    elif [[ "$next" == held* ]]; then
        printf '%s · %s\n' "$(mode)" "$next"
    else
        printf '%s · auto · %s\n' "$(mode)" "$next"
    fi
    if [[ "${1:-}" == -v ]]; then
        [[ -f "$RUN_DIR/mode-timing" ]] && printf 'last switch: %s ms before the reveal\n' "$(cat "$RUN_DIR/mode-timing")"
        if [[ -L "$HOME/.config/kitty/dark-theme.auto.conf" ]]; then
            echo "kitty: automatic light/dark themes (plus SIGUSR1 for the rest of kitty.conf)"
        else
            echo "kitty: re-reads kitty.conf on SIGUSR1"
        fi
    fi
}

mode_cmd() {
    local instant=0 source=manual args=() a
    for a in "$@"; do
        case "$a" in
            --instant) instant=1 ;;
            --from-auto) source=auto ;;
            *) args+=("$a") ;;
        esac
    done
    case "${args[0]:-status}" in
        light|dark|toggle)
            local target="${args[0]}"
            [[ "$target" == toggle ]] && target="$([[ "$(mode)" == dark ]] && echo light || echo dark)"
            mode_set "$target" "$source" "$instant"
            [[ "$source" == manual ]] && hold ;;
        auto) mode_auto "${args[1]:-on}" "$instant" ;;
        tick) mode_tick "$instant" ;;
        status) mode_status "${args[1]:-}" ;;
        *) die "usage: rice mode light|dark|toggle|auto [off]|tick|status [--instant]" ;;
    esac
}

json_str() {
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

# what the chooser shows: { current, mode, mode_auto, mode_next,
# rices: [{ name, card, preview, meta }] }
json() {
    local r first=1 meta
    printf '{"current":%s,"mode":%s,"mode_auto":%s,"mode_next":%s,"rices":[' \
        "$(json_str "$(current || true)")" \
        "$(json_str "$(mode)")" \
        "$(auto_on && echo true || echo false)" \
        "$(json_str "$(next_switch)")"
    while read -r r; do
        meta="$RICE_DIR/$r/build/$(mode)/meta.json"
        [[ -f "$meta" ]] || render "$r" >/dev/null 2>&1 || true
        (( first )) || printf ','
        first=0
        printf '{"name":%s,"card":%s,"preview":%s,"meta":' \
            "$(json_str "$r")" \
            "$([[ -f "$RICE_DIR/$r/card.qml" ]] && echo true || echo false)" \
            "$([[ -f "$RICE_DIR/$r/preview.png" ]] && json_str "$RICE_DIR/$r/preview.png" || echo null)"
        if [[ -f "$meta" ]]; then cat "$meta"; else printf '{"name":%s}' "$(json_str "$r")"; fi
        printf '}'
    done < <(rices)
    printf ']}\n'
}

usage() { sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
    ""|-h|--help|help) usage ;;
    list)
        cur="$(current || true)"
        while read -r r; do
            if [[ "$r" == "$cur" ]]; then printf '* %s\n' "$r"; else printf '  %s\n' "$r"; fi
        done < <(rices) ;;
    current) current || die "no active rice" ;;
    get)
        [[ -n "${2:-}" && "$2" == *.* ]] || die "usage: rice get section.key"
        toml_get "$RICE_DIR/current/palette.toml" "${2%.*}" "${2##*.}" ;;
    next) cycle 1 ;;
    prev) cycle -1 ;;
    mode) shift; mode_cmd "$@" ;;
    choose) choose ;;
    reapply) RICE_FORCE=1 switch_to "$(current)" ;;
    recolour|recolor) recolour ;;
    session) session ;;
    lock) lock ;;
    grain) shift; grain "$@" ;;
    logout) logout ;;
    system) shift; system_theme "$@" ;;
    json) json ;;
    on-battery) on_battery ;;
    -*) die "unknown option: $1" ;;
    *) switch_to "$1" ;;
esac
