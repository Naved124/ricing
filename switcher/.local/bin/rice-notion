#!/usr/bin/env python3
"""rice-notion — the Notion widget's one link to Notion (stdlib only).

    rice-notion check                  is the token good, and what do the databases hold
    rice-notion snapshot               one snapshot, as JSON
    rice-notion watch                  a snapshot now and every `refresh` seconds, one JSON
                                       line each; commands on stdin, one JSON object a line
    rice-notion add TEXT [--due DATE]  a task (DATE: today, tomorrow, +3, or 2026-11-02)
    rice-notion capture TEXT           a note in the inbox (first line the title)

Settings: ~/.config/rice/notion.toml (an example is in
~/.local/share/rice/notion.example.toml). The token is an internal
integration's secret (notion.so/my-integrations); only pages and databases
shared with that integration can be read. IDs may be pasted as links.

    token = "ntn_…"          # or token_file = "~/.secrets/notion", or $NOTION_TOKEN
    refresh = 90             # seconds between snapshots
    app = false              # open pages with notion:// (the desktop app) instead of https://

    [tasks]
    database = "…"
    title = "Name"           # the title property
    done = "Done"            # a checkbox, or a status/select whose done_value means done
    done_value = "Done"      # (status/select only)
    todo_value = ""          # what unticking sets it to (status/select; "" = the first option)
    due = "Due"              # a date (optional)
    status = ""              # a status/select shown and set from the panel (optional)
    priority = ""            # a select (optional)

    [agenda]
    database = "…"           # may be the tasks database
    title = "Name"
    date = "Date"
    days = 7

    [inbox]
    database = "…"
    title = "Name"

    [pinned]
    page = "…"               # its to-dos

Commands (watch's stdin):
    {"op": "done", "id": PAGE, "on": true}       tick or untick a task
    {"op": "todo", "id": BLOCK, "on": true}      tick or untick a pinned to-do
    {"op": "status", "id": PAGE, "value": "…"}   set a task's status
    {"op": "add", "text": "…", "due": "today"}   a new task
    {"op": "capture", "text": "…"}               a note in the inbox
    {"op": "refresh"}

Each line out is {"kind": "snapshot", ...} or {"kind": "result", "op", "ok", "error"};
after every command a fresh snapshot follows. Snapshots are also kept in
~/.cache/rice/notion.json, so the widget opens on the last one, offline too.
On a failure the snapshot keeps the last good data, says why in "error", and
the next try backs off (to 5 minutes; a 429's Retry-After is honoured).
NOTION_API stands in for https://api.notion.com (the tests' fake server).
"""

from __future__ import annotations

import argparse
import json
import os
import queue
import re
import sys
import threading
import time
import tomllib
import urllib.error
import urllib.request
from datetime import date, datetime, timedelta
from pathlib import Path

API = os.environ.get("NOTION_API", "https://api.notion.com").rstrip("/")
VERSION = "2022-06-28"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "rice/notion.toml"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rice/notion.json"
MAX_BACKOFF = 300


class NotionError(Exception):
    def __init__(self, message: str, retry_after: float | None = None):
        super().__init__(message)
        self.retry_after = retry_after


# ── settings ────────────────────────────────────────────────────────────────
def page_id(s: str) -> str:
    """An ID from an ID or a pasted link (the last 32 hex digits, dashed)."""
    s = (s or "").strip()
    found = re.findall(r"[0-9a-fA-F]{32}|[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}", s)
    if not found:
        return s
    h = found[-1].replace("-", "").lower()
    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:]}"


def load_config() -> dict:
    try:
        cfg = tomllib.loads(CONFIG.read_text())
    except FileNotFoundError:
        cfg = {}
    token = os.environ.get("NOTION_TOKEN") or cfg.get("token", "")
    if not token and cfg.get("token_file"):
        try:
            token = Path(os.path.expanduser(cfg["token_file"])).read_text().strip()
        except OSError:
            token = ""
    cfg["token"] = token.strip()
    cfg.setdefault("refresh", 90)
    for section, key in (("tasks", "database"), ("agenda", "database"), ("inbox", "database"), ("pinned", "page")):
        sec = cfg.setdefault(section, {})
        if sec.get(key):
            sec[key] = page_id(sec[key])
    t = cfg["tasks"]
    t.setdefault("title", "Name"); t.setdefault("done", "Done"); t.setdefault("done_value", "Done")
    t.setdefault("todo_value", ""); t.setdefault("due", "Due"); t.setdefault("status", ""); t.setdefault("priority", "")
    a = cfg["agenda"]
    a.setdefault("title", "Name"); a.setdefault("date", "Date"); a.setdefault("days", 7)
    cfg["inbox"].setdefault("title", "Name")
    return cfg


# ── the API ─────────────────────────────────────────────────────────────────
class Notion:
    def __init__(self, token: str):
        self.token = token
        self.schemas: dict[str, dict] = {}

    def call(self, method: str, path: str, body: dict | None = None) -> dict:
        req = urllib.request.Request(
            API + path, method=method,
            data=json.dumps(body).encode() if body is not None else None,
            headers={"Authorization": f"Bearer {self.token}", "Notion-Version": VERSION,
                     "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                return json.loads(r.read() or b"{}")
        except urllib.error.HTTPError as e:
            try:
                msg = json.loads(e.read()).get("message", "")
            except (ValueError, OSError):
                msg = ""
            if e.code == 429:
                raise NotionError("Notion asked to slow down", float(e.headers.get("Retry-After") or 30))
            if e.code == 401:
                raise NotionError("the token was refused (check notion.toml)")
            if e.code == 404:
                raise NotionError(f"not found or not shared with the integration: {msg or path}")
            raise NotionError(msg or f"HTTP {e.code}")
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            raise NotionError(f"offline ({getattr(e, 'reason', e)})")

    def schema(self, db: str) -> dict:
        if db not in self.schemas:
            self.schemas[db] = self.call("GET", f"/v1/databases/{db}")
        return self.schemas[db]

    def query(self, db: str, body: dict, limit: int = 100) -> list[dict]:
        out, cursor = [], None
        while len(out) < limit:
            b = dict(body, page_size=min(100, limit - len(out)))
            if cursor:
                b["start_cursor"] = cursor
            r = self.call("POST", f"/v1/databases/{db}/query", b)
            out += r.get("results", [])
            cursor = r.get("next_cursor")
            if not r.get("has_more") or not cursor:
                break
        return out


def plain(rich: list | None) -> str:
    return "".join(x.get("plain_text", "") for x in rich or [])


def prop_type(schema: dict, name: str) -> str:
    return (schema.get("properties", {}).get(name) or {}).get("type", "")


def title_of(page: dict) -> str:
    if page.get("object") == "database":
        return plain(page.get("title")) or "Untitled"
    for p in page.get("properties", {}).values():
        if p.get("type") == "title":
            return plain(p["title"]) or "Untitled"
    return "Untitled"


def value(prop: dict | None):
    """A property's value, flattened: text, bool, a date's start, an option's name."""
    if not prop:
        return None
    t = prop.get("type")
    v = prop.get(t)
    if t in ("title", "rich_text"):
        return plain(v)
    if t in ("status", "select"):
        return (v or {}).get("name")
    if t == "date":
        return v
    if t == "multi_select":
        return [o.get("name") for o in v or []]
    if t == "formula":
        return (v or {}).get((v or {}).get("type"))
    return v


def icon_of(page: dict) -> str:
    i = page.get("icon") or {}
    return i.get("emoji", "") if i.get("type") == "emoji" else ""


def when(s: str, today: date | None = None) -> str:
    """today, tomorrow, +N (days), a weekday (mon…sun, the next one) or an ISO date → ISO date."""
    today = today or date.today()
    s = (s or "").strip().lower()
    if not s:
        return ""
    if s in ("today", "tod"):
        return today.isoformat()
    if s in ("tomorrow", "tom", "tmr"):
        return (today + timedelta(days=1)).isoformat()
    if re.fullmatch(r"\+\d+", s):
        return (today + timedelta(days=int(s[1:]))).isoformat()
    days = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
    if s[:3] in days:
        ahead = (days.index(s[:3]) - today.weekday()) % 7 or 7
        return (today + timedelta(days=ahead)).isoformat()
    return date.fromisoformat(s).isoformat()


def open_url(cfg: dict, url: str) -> str:
    return url.replace("https://", "notion://", 1) if cfg.get("app") and url else url


# ── a snapshot ──────────────────────────────────────────────────────────────
def tasks(n: Notion, cfg: dict, today: date) -> dict:
    t = cfg["tasks"]
    db = t.get("database")
    if not db:
        return {"configured": False, "items": [], "statuses": []}
    schema = n.schema(db)
    kind = prop_type(schema, t["done"])
    if kind == "checkbox":
        open_filter = {"property": t["done"], "checkbox": {"equals": False}}
    elif kind in ("status", "select"):
        open_filter = {"property": t["done"], kind: {"does_not_equal": t["done_value"]}}
    else:
        raise NotionError(f"tasks: no checkbox, status or select called “{t['done']}”")
    due_name = t["due"] if prop_type(schema, t["due"]) == "date" else ""     # a missing Due: no dates
    sorts = [{"property": due_name, "direction": "ascending"}] if due_name else []
    sorts.append({"timestamp": "created_time", "direction": "descending"})
    rows = n.query(db, {"filter": open_filter, "sorts": sorts}, limit=100)
    status_name = t["status"] or (t["done"] if kind in ("status", "select") else "")
    st_kind = prop_type(schema, status_name) if status_name else ""
    statuses = [o["name"] for o in (schema["properties"][status_name][st_kind].get("options", []) if st_kind in ("status", "select") else [])]
    items = []
    for r in rows:
        props = r.get("properties", {})
        due = value(props.get(due_name)) if due_name else None
        start = (due or {}).get("start") or ""
        items.append({
            "id": r["id"], "title": value(props.get(t["title"])) or title_of(r), "icon": icon_of(r),
            "url": open_url(cfg, r.get("url", "")), "done": False,
            "due": start, "dueTime": "T" in start,
            "overdue": bool(start) and start[:10] < today.isoformat(),
            "today": start[:10] == today.isoformat(),
            "status": value(props.get(status_name)) if status_name else None,
            "priority": value(props.get(t["priority"])) if t["priority"] else None,
        })
    return {"configured": True, "items": items, "statuses": statuses, "doneKind": kind}


def agenda(n: Notion, cfg: dict, today: date) -> dict:
    a = cfg["agenda"]
    db = a.get("database")
    if not db:
        return {"configured": False, "items": []}
    if prop_type(n.schema(db), a["date"]) != "date":
        raise NotionError(f"agenda: no date called “{a['date']}”")
    last = today + timedelta(days=int(a["days"]))
    rows = n.query(db, {"filter": {"and": [
        {"property": a["date"], "date": {"on_or_after": today.isoformat()}},
        {"property": a["date"], "date": {"on_or_before": last.isoformat()}}]},
        "sorts": [{"property": a["date"], "direction": "ascending"}]}, limit=60)
    items = []
    for r in rows:
        d = value(r.get("properties", {}).get(a["date"])) or {}
        start = d.get("start") or ""
        items.append({"id": r["id"], "title": value(r["properties"].get(a["title"])) or title_of(r),
                      "icon": icon_of(r), "url": open_url(cfg, r.get("url", "")),
                      "day": start[:10], "start": start, "end": d.get("end") or "", "allDay": "T" not in start})
    return {"configured": True, "items": items}


def pinned(n: Notion, cfg: dict) -> dict:
    pid = cfg["pinned"].get("page")
    if not pid:
        return {"configured": False, "title": "", "url": "", "items": []}
    page = n.call("GET", f"/v1/pages/{pid}")
    blocks = n.call("GET", f"/v1/blocks/{pid}/children?page_size=100").get("results", [])
    items, heading = [], ""
    for b in blocks:
        t = b.get("type", "")
        if t.startswith("heading_"):
            heading = plain(b[t].get("rich_text"))
        elif t == "to_do":
            items.append({"id": b["id"], "text": plain(b["to_do"].get("rich_text")),
                          "done": bool(b["to_do"].get("checked")), "group": heading})
    return {"configured": True, "title": title_of(page), "icon": icon_of(page),
            "url": open_url(cfg, page.get("url", "")), "items": items}


def recent(n: Notion, cfg: dict) -> list[dict]:
    r = n.call("POST", "/v1/search", {"sort": {"direction": "descending", "timestamp": "last_edited_time"},
                                       "page_size": 10})
    return [{"id": p["id"], "title": title_of(p), "icon": icon_of(p), "kind": p.get("object", "page"),
             "url": open_url(cfg, p.get("url", "")), "edited": p.get("last_edited_time", "")}
            for p in r.get("results", []) if not p.get("archived") and not p.get("in_trash")][:8]


def snapshot(n: Notion, cfg: dict) -> dict:
    today = date.today()
    snap = {"kind": "snapshot", "ok": True, "error": "", "at": int(time.time()), "today": today.isoformat(),
            "inbox": bool(cfg["inbox"].get("database")) or bool(cfg["tasks"].get("database"))}
    errors = []
    for key, fn in (("tasks", lambda: tasks(n, cfg, today)), ("agenda", lambda: agenda(n, cfg, today)),
                    ("pinned", lambda: pinned(n, cfg)), ("recent", lambda: recent(n, cfg))):
        try:
            snap[key] = fn()
        except NotionError as e:
            if e.retry_after is not None or str(e).startswith(("offline", "the token")):
                raise
            errors.append(f"{key}: {e}" if not str(e).startswith(key) else str(e))
    if errors:
        snap["error"] = "; ".join(errors)
    return snap


def keep(snap: dict) -> None:
    try:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(snap))
        tmp.replace(CACHE)
    except OSError:
        pass


def cached() -> dict:
    try:
        return json.loads(CACHE.read_text())
    except (OSError, ValueError):
        return {}


# ── changes ─────────────────────────────────────────────────────────────────
def title_prop(text: str) -> dict:
    return {"title": [{"type": "text", "text": {"content": text[:2000]}}]}


def run(n: Notion, cfg: dict, cmd: dict) -> None:
    op = cmd.get("op")
    t = cfg["tasks"]
    if op == "done":
        kind = prop_type(n.schema(t["database"]), t["done"])
        on = bool(cmd.get("on"))
        if kind == "checkbox":
            p = {"checkbox": on}
        else:
            opts = [o["name"] for o in n.schema(t["database"])["properties"][t["done"]][kind].get("options", [])]
            back = t["todo_value"] or next((o for o in opts if o != t["done_value"]), "")
            p = {kind: {"name": t["done_value"] if on else back}}
        n.call("PATCH", f"/v1/pages/{cmd['id']}", {"properties": {t["done"]: p}})
    elif op == "todo":
        n.call("PATCH", f"/v1/blocks/{cmd['id']}", {"to_do": {"checked": bool(cmd.get("on"))}})
    elif op == "status":
        name = t["status"] or t["done"]
        kind = prop_type(n.schema(t["database"]), name)
        n.call("PATCH", f"/v1/pages/{cmd['id']}", {"properties": {name: {kind: {"name": cmd["value"]}}}})
    elif op == "add":
        if not t.get("database"):
            raise NotionError("no tasks database in notion.toml")
        props = {t["title"]: title_prop(cmd["text"].strip())}
        due = when(cmd.get("due", ""))
        if due and prop_type(n.schema(t["database"]), t["due"]) == "date":
            props[t["due"]] = {"date": {"start": due}}
        n.call("POST", "/v1/pages", {"parent": {"database_id": t["database"]}, "properties": props})
    elif op == "capture":
        db = cfg["inbox"].get("database") or t.get("database")
        title = cfg["inbox"]["title"] if cfg["inbox"].get("database") else t["title"]
        if not db:
            raise NotionError("no inbox database in notion.toml")
        first, _, rest = cmd["text"].strip().partition("\n")
        body = {"parent": {"database_id": db}, "properties": {title: title_prop(first)}}
        paras = [p for p in rest.split("\n") if p.strip()]
        if paras:
            body["children"] = [{"object": "block", "type": "paragraph",
                                 "paragraph": {"rich_text": [{"type": "text", "text": {"content": p[:2000]}}]}}
                                for p in paras[:100]]
        n.call("POST", "/v1/pages", body)
    elif op != "refresh":
        raise NotionError(f"unknown command {op!r}")


# ── watch ───────────────────────────────────────────────────────────────────
def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def watch(cfg: dict) -> int:
    last = cached()
    if last:
        emit(dict(last, kind="snapshot", stale=True))
    if not cfg["token"]:
        emit(dict(last or {}, kind="snapshot", ok=False, setup=True,
                  error=f"no token: add one to {CONFIG} (see notion.example.toml)"))
    n = Notion(cfg["token"])
    inbox: queue.Queue = queue.Queue()

    def read() -> None:
        for line in sys.stdin:
            line = line.strip()
            if line:
                try:
                    inbox.put(json.loads(line))
                except ValueError:
                    emit({"kind": "result", "op": "?", "ok": False, "error": "a command that isn't JSON"})
        inbox.put(None)                      # the shell went away

    threading.Thread(target=read, daemon=True).start()
    wait, backoff = 0.0, 15.0
    while True:
        try:
            cmd = inbox.get(timeout=wait) if wait > 0 else inbox.get_nowait()
        except queue.Empty:
            cmd = {"op": "tick"}             # the timer: the schemas stay cached
        if cmd is None:
            return 0
        if not cfg["token"]:
            wait = 3600
            continue
        if cmd.get("op") == "refresh":
            n.schemas.clear()                # asked for: read the databases' properties again
        elif cmd.get("op") != "tick":
            try:
                run(n, cfg, cmd)
                emit({"kind": "result", "op": cmd.get("op"), "ok": True, "error": ""})
            except (NotionError, KeyError, ValueError) as e:
                emit({"kind": "result", "op": cmd.get("op"), "ok": False, "error": str(e)})
        try:
            snap = snapshot(n, cfg)
            last = snap
            keep(snap)
            emit(snap)
            wait, backoff = float(cfg["refresh"]), 15.0
        except NotionError as e:
            emit(dict(last or {}, kind="snapshot", ok=False, stale=True, error=str(e)))
            wait = e.retry_after if e.retry_after is not None else backoff
            backoff = min(MAX_BACKOFF, backoff * 2)


# ── check ───────────────────────────────────────────────────────────────────
def check(cfg: dict) -> int:
    ok = True

    def say(good: bool, text: str) -> None:
        nonlocal ok
        ok &= good
        print(("  ok  " if good else "  !!  ") + text)

    if not cfg["token"]:
        say(False, f"no token in {CONFIG} (or token_file, or $NOTION_TOKEN)")
        return 1
    if CONFIG.exists() and CONFIG.stat().st_mode & 0o077 and "token" in tomllib.loads(CONFIG.read_text()):
        say(False, f"{CONFIG} holds the token and others can read it: chmod 600 it")
    n = Notion(cfg["token"])
    try:
        me = n.call("GET", "/v1/users/me")
        say(True, f"token works: {me.get('name') or me.get('bot', {}).get('workspace_name') or 'the integration'}")
    except NotionError as e:
        say(False, str(e))
        return 1
    wants = {"tasks": [("title", "title"), ("done", "checkbox status select"), ("due", "date"),
                       ("status", "status select"), ("priority", "select")],
             "agenda": [("title", "title"), ("date", "date")], "inbox": [("title", "title")]}
    for section, props in wants.items():
        db = cfg[section].get("database")
        if not db:
            print(f"  --  {section}: not set")
            continue
        try:
            s = n.schema(db)
        except NotionError as e:
            say(False, f"{section}: {e}")
            continue
        say(True, f"{section}: {plain(s.get('title')) or db}")
        for key, types in props:
            name = cfg[section].get(key)
            if not name:
                continue
            got = prop_type(s, name)
            say(got in types.split(), f"   {key} = “{name}” ({got or 'missing'}; wants {types.replace(' ', ' or ')})")
        if section == "tasks" and prop_type(s, cfg["tasks"]["done"]) in ("status", "select"):
            kind = prop_type(s, cfg["tasks"]["done"])
            opts = [o["name"] for o in s["properties"][cfg["tasks"]["done"]][kind].get("options", [])]
            say(cfg["tasks"]["done_value"] in opts, f"   done_value = “{cfg['tasks']['done_value']}” (options: {', '.join(opts)})")
        if any(prop_type(s, cfg[section].get(k, "")) == "" for k, _ in props if cfg[section].get(k)):
            print("      its properties: " + ", ".join(f"{k} ({v['type']})" for k, v in s.get("properties", {}).items()))
    if cfg["pinned"].get("page"):
        try:
            say(True, f"pinned: {title_of(n.call('GET', '/v1/pages/' + cfg['pinned']['page']))}")
        except NotionError as e:
            say(False, f"pinned: {e}")
    else:
        print("  --  pinned: not set")
    return 0 if ok else 1


def main() -> int:
    ap = argparse.ArgumentParser(prog="rice-notion", description="The Notion widget's link to Notion.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("check")
    sub.add_parser("snapshot")
    sub.add_parser("watch")
    a = sub.add_parser("add")
    a.add_argument("text", nargs="+")
    a.add_argument("--due", default="")
    c = sub.add_parser("capture")
    c.add_argument("text", nargs="+")
    args = ap.parse_args()
    cfg = load_config()
    if args.cmd == "watch":
        try:
            return watch(cfg)
        except (KeyboardInterrupt, BrokenPipeError):
            return 0
    if args.cmd == "check":
        return check(cfg)
    if not cfg["token"]:
        print(f"rice-notion: no token in {CONFIG}", file=sys.stderr)
        return 1
    n = Notion(cfg["token"])
    try:
        if args.cmd == "snapshot":
            snap = snapshot(n, cfg)
            keep(snap)
            print(json.dumps(snap, indent=2))
        else:
            run(n, cfg, {"op": args.cmd, "text": " ".join(args.text), "due": getattr(args, "due", "")})
    except (NotionError, ValueError) as e:
        print(f"rice-notion: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
