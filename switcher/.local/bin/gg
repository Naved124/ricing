#!/usr/bin/env bash
# gg — Golden Gate's one way in: the keybinds, the Control Center, System
# Settings and the terminal all go through it.
#
#   gg appearance [light|dark|toggle|auto [off]]
#                          light and dark for the whole desktop (rice mode);
#                          auto follows the sun at the location below
#   gg location LAT LON    where the sun is, for auto (shared with every rice)
#   gg accent [NAME]       blue purple pink red orange yellow green graphite
#                          multicolor, or wallpaper (the picture's vivid colour,
#                          snapped to the nearest Apple hue)
#   gg glass [liquid|frosted|solid|next] | gg glass clarity 0..1
#                          the glass, live; clarity 0 is Ultraclear, 1 Tinted
#   gg glass backend auto|hyprglass|hyprliquid|shader | apply | status
#   gg wall set FILE [DARK] | pick | next | prev | seed | status
#   gg dock | spotlight | mission | expose | cc | nc | apps | switcher
#                          open (or close) the shell's surfaces
#   gg desktop             Show Desktop (and back)
#   gg win close|quit|minimize|zoom|fill|center [ADDRESS]|tilemenu|hide|hide-others|show-all|cycle|quit-app CLASS
#   gg win tile left|right|up|down | restore ADDRESS | unhide CLASS
#                          the focused window (what the traffic lights and binds do)
#   gg settings [PANE]     System Settings, at a pane
#   gg lock                the lock screen
#   gg screenshot screen|selection|window|toolbar
#   gg record screen|selection|stop
#   gg island test ACTIVITY
#   gg widgets edit
#   gg notify-done CMD SECS   a long command finished (for the shell's hook)
#   gg get KEY | gg set KEY JSON
#                          read or write one setting (e.g. gg set dock.size 64)
#   gg hook enter|post-switch|post-mode|leave
#                          what the rice's hooks run
#
# Settings live in ~/.config/goldengate/settings.json; the shell watches it.

set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/goldengate"
SETTINGS="${GG_SETTINGS:-$CONF/goldengate/settings.json}"
OVERLAY="$STATE/palette.toml"
RICE_DIR="${RICE_DIR:-$CONF/rices}"
SHELL_NAME=goldengate

log() { printf '\033[2mgg:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31mgg:\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

mkdir -p "$STATE" "$(dirname "$SETTINGS")"

active() { [[ "$(basename "$(readlink "$RICE_DIR/current" 2>/dev/null || true)")" == goldengate ]]; }
mode() {
    local m
    m="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/rice/mode" 2>/dev/null || true)"
    [[ "$m" == dark ]] && echo dark || echo light
}

# ── the shell ────────────────────────────────────────────────────────────
ipc() {   # ipc TARGET FUNCTION [ARGS…]
    have qs || die "quickshell isn't installed"
    qs -c "$SHELL_NAME" ipc call "$@"
}
# a surface: the shell answers, or says why not (qs exits 0 on a missing
# target, so its answer is read)
has_surface() {
    local out
    out="$(ipc "$@" 2>&1)" || return 1
    [[ "$out" != *"not found"* ]]
}
surface() {
    has_surface "$@" || die "the Golden Gate shell isn't running (rice goldengate), or has no '$1 $2'"
}

# ── settings.json ────────────────────────────────────────────────────────
get() {   # get KEY (dotted): the JSON value, or nothing
    [[ -s "$SETTINGS" ]] || return 0
    jq -c --arg k "$1" 'getpath($k | split(".")) // empty' "$SETTINGS"
}
get_str() { get "$1" | jq -r '. // empty' 2>/dev/null || true; }
set_json() {   # set_json KEY JSON: atomically, so the shell never reads half a file
    have jq || die "jq is needed"
    local tmp
    jq . >/dev/null 2>&1 <<<"$2" || die "not JSON: $2 (strings need quotes: '\"blue\"')"
    tmp="$(mktemp "$SETTINGS.XXXXXX")"
    if [[ -s "$SETTINGS" ]]; then
        jq --arg k "$1" --argjson v "$2" 'setpath($k | split("."); $v)' "$SETTINGS" > "$tmp"
    else
        jq -n --arg k "$1" --argjson v "$2" 'setpath($k | split("."); $v)' > "$tmp"
    fi
    mv -f "$tmp" "$SETTINGS"
}
set_str() { set_json "$1" "$(jq -n --arg v "$2" '$v')"; }

# ── the palette overlay (what apps see) ──────────────────────────────────
ACCENTS=(blue purple pink red orange yellow green graphite)

# the overlay rice-render merges over palette.toml: the accent (a colour name,
# or the wallpaper's hex), the GTK and icon names in that accent, and the
# terminal's opacity from the glass's clarity
write_overlay() {
    local a base light dark clarity term m gtk icons
    a="$(get_str appearance.accent)"; a="${a:-blue}"
    base="$a"
    case "$a" in
        multicolor) light=blue; dark=blue ;;
        wallpaper)
            base="$(get_str appearance.accentBase)"; base="${base:-blue}"
            light="\"$(get_str appearance.accentWall.light)\""
            dark="\"$(get_str appearance.accentWall.dark)\""
            [[ "$light" != '""' ]] || light="$base"
            [[ "$dark" != '""' ]] || dark="$base" ;;
        *) light="$a"; dark="$a" ;;
    esac
    [[ "$light" == \"* ]] || light="\"$light\""
    [[ "$dark" == \"* ]] || dark="\"$dark\""
    clarity="$(get_str glass.clarity)"; clarity="${clarity:-0.35}"
    # the terminal's opacity by the clarity, high enough that its text holds up
    # over a bright frost: light 0.86 (Ultraclear) … 0.98 (Tinted), dark 0.80 … 0.97
    local term_light term_dark
    term_light="$(awk -v c="$clarity" 'BEGIN { printf "%.2f", 0.86 + 0.12 * c }')"
    term_dark="$(awk -v c="$clarity" 'BEGIN { printf "%.2f", 0.80 + 0.17 * c }')"
    if [[ "$(get_str glass.mode)" == solid || "$(get_str accessibility.reduceTransparency)" == true ]]; then
        term_light=1.0; term_dark=1.0
    fi
    {
        echo "# Written by gg from ~/.config/goldengate/settings.json; rice-render merges it"
        echo "# over Golden Gate's palette.toml. Change it with gg accent / gg glass."
        for m in light dark; do
            read -r gtk icons < <(gg-theme names "$m" "$base" | jq -r '"\(.gtk) \(.icons)"')
            echo
            echo "[modes.$m.meta]"
            echo "gtk_theme  = \"$gtk\""
            echo "icon_theme = \"$icons\""
            echo
            echo "[modes.$m.roles]"
            if [[ "$m" == light ]]; then echo "accent = $light"; echo "cursor = $light"
            else echo "accent = $dark"; echo "cursor = $dark"; fi
            echo
            echo "[modes.$m.opacity]"
            if [[ "$m" == light ]]; then term="$term_light"; else term="$term_dark"; fi
            echo "terminal = $term"
        done
    } > "$OVERLAY.tmp"
    # say whether anything changed (the caller re-renders only then)
    if cmp -s "$OVERLAY.tmp" "$OVERLAY"; then rm -f "$OVERLAY.tmp"; return 1; fi
    mv -f "$OVERLAY.tmp" "$OVERLAY"
}

# render and push the colours out live, when Golden Gate is the rice on screen
recolour() {
    write_overlay || true
    if active; then
        rice recolour >/dev/null 2>&1 || log "rice recolour failed"
        gg-theme apply >/dev/null 2>&1 || log "gg-theme apply failed"
    else
        rice-render -q goldengate || true
    fi
}

# ── appearance ───────────────────────────────────────────────────────────
appearance() {
    case "${1:-status}" in
        light|dark|toggle) rice mode "$1" ;;
        auto) shift; rice mode auto "$@" ;;
        status) rice mode status ;;
        *) die "usage: gg appearance light|dark|toggle|auto [off]|status" ;;
    esac
}

# where the sun is: ~/.config/rice/mode.toml (every rice's), and Settings
location() {
    local lat="${1:-}" lon="${2:-}" f="$CONF/rice/mode.toml"
    [[ "$lat" =~ ^-?[0-9]+(\.[0-9]+)?$ && "$lon" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] \
        || die "usage: gg location LAT LON (degrees, north and east positive)"
    mkdir -p "$(dirname "$f")"
    [[ -f "$f" ]] || printf 'lat = ""\nlon = ""\n' > "$f"
    sed -i -E "s/^lat[[:space:]]*=.*/lat = $lat/; s/^lon[[:space:]]*=.*/lon = $lon/" "$f"
    set_json location.lat "$lat"
    set_json location.lon "$lon"
    log "location $lat, $lon"
}

# ── accent ───────────────────────────────────────────────────────────────
# the wallpaper's most vivid common colour (ImageMagick), snapped to the
# nearest Apple hue and clamped to Apple-like saturation and lightness;
# prints "base light-hex dark-hex"
wallpaper_accent() {
    local file="$1"
    have magick || die "ImageMagick is needed for the wallpaper accent"
    [[ -r "$file" ]] || die "no wallpaper to take a colour from ($file)"
    magick "${file}[0]" -resize 96x96 -colors 12 -format '%c' histogram:info:- 2>/dev/null \
        | python3 -c '
import colorsys, re, sys
apple = {"red": 3, "orange": 35, "yellow": 48, "green": 129, "blue": 211, "purple": 282, "pink": 348}
best = None
for line in sys.stdin:
    m = re.search(r"^\s*(\d+):.*#([0-9A-Fa-f]{6})", line)
    if not m:
        continue
    n, hx = int(m[1]), m[2]
    r, g, b = (int(hx[i:i + 2], 16) / 255 for i in (0, 2, 4))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    if s < 0.25 or not 0.18 < l < 0.85:
        continue                          # greys, near-black and near-white say nothing
    score = n * (s ** 2)                  # common and vivid
    if best is None or score > best[0]:
        best = (score, h * 360)
if best is None:
    print("blue #007aff #0a84ff"); sys.exit()
hue = best[1]
name = min(apple, key=lambda k: min(abs(apple[k] - hue), 360 - abs(apple[k] - hue)))
# keep the picture'"'"'s hue, but only so far from Apple'"'"'s, at Apple'"'"'s saturation and lightness
target = apple[name]
delta = ((hue - target + 180) % 360) - 180
hue = (target + max(-12, min(12, delta))) % 360
def hexof(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h / 360, l, s)
    return "#%02x%02x%02x" % tuple(round(v * 255) for v in (r, g, b))
print(name, hexof(hue, 0.48, 0.95), hexof(hue, 0.56, 0.92))
'
}

accent() {
    local a="${1:-}" file base l d
    if [[ -z "$a" ]]; then get_str appearance.accent; return; fi
    case "$a" in
        blue|purple|pink|red|orange|yellow|green|graphite|multicolor)
            set_str appearance.accent "$a"
            set_str appearance.accentBase "$([[ "$a" == multicolor ]] && echo blue || echo "$a")" ;;
        wallpaper|from-wallpaper)
            file="$(get_str wallpaper.current)"; file="${file/#\~/$HOME}"
            [[ "$(mode)" == dark && -n "$(get_str wallpaper.currentDark)" ]] && { file="$(get_str wallpaper.currentDark)"; file="${file/#\~/$HOME}"; }
            read -r base l d < <(wallpaper_accent "$file")
            set_str appearance.accent wallpaper
            set_str appearance.accentBase "$base"
            set_json appearance.accentWall "$(jq -n --arg l "$l" --arg d "$d" '{light: $l, dark: $d}')"
            log "from the wallpaper: $l / $d (nearest Apple accent: $base)" ;;
        *) die "accents: ${ACCENTS[*]} multicolor wallpaper" ;;
    esac
    recolour
}

# ── glass ────────────────────────────────────────────────────────────────
# Liquid is a compositor plugin (hyprglass, or hyprliquid), loaded with
# `hyprctl plugin load` only while Golden Gate is on screen and never enabled
# in hyprpm; Frosted is Hyprland's blur; Solid is none. A Liquid that can't
# run (the plugin paused after a Hyprland update, missing, failing) falls
# back to Frosted, and glass.json says why (the shell shows it).
HYPRGLASS="${GG_HYPRGLASS:-/var/cache/hyprpm/${USER:-$(id -un)}/HyprGlass/hyprglass.so}"
HYPRLIQUID="${GG_HYPRLIQUID:-/usr/lib/libhyprliquid.so}"
HYPRBARS="${GG_HYPRBARS:-/var/cache/hyprpm/${USER:-$(id -un)}/hyprland-plugins/hyprbars.so}"
GLASS_STATE="$STATE/glass-state.lua"   # read by the rice's glass.lua
GLASS_JSON="$STATE/glass.json"         # what's on screen, for the shell
GLASS_LUA="${XDG_DATA_HOME:-$HOME/.local/share}/rice/active/glass.lua"

plugin_path() { case "$1" in hyprglass) echo "$HYPRGLASS" ;; hyprliquid) echo "$HYPRLIQUID" ;; hyprbars) echo "$HYPRBARS" ;; esac; }
loaded() {   # loaded NAME: hyprctl lists it
    hyprctl -j plugin list 2>/dev/null | jq -e --arg n "$1" 'type == "array" and any(.[]; (.name | ascii_downcase) == $n)' >/dev/null 2>&1
}
plugin_unload() {
    loaded "$1" || return 0
    hyprctl plugin unload "$(plugin_path "$1")" >/dev/null 2>&1 || log "couldn't unload $1"
}
# plugin_try NAME: load it and check it draws; prints why not, and unloads it
plugin_try() {
    local name="$1" path out desc
    path="$(plugin_path "$name")"
    [[ -f "$path" ]] || { echo "$name isn't installed"; return 1; }
    if ! loaded "$name"; then
        out="$(hyprctl plugin load "$path" 2>&1)" || true
        loaded "$name" || { echo "$name didn't load (${out:-no answer})"; return 1; }
    fi
    # a plugin built for another Hyprland stays loaded but paused
    desc="$(hyprctl -j plugin list | jq -r --arg n "$name" '.[] | select((.name | ascii_downcase) == $n) | .description')"
    if [[ "$desc" == Paused* ]]; then plugin_unload "$name"; echo "$name is paused: ${desc#*: }"; return 1; fi
    if [[ "$name" == hyprglass ]]; then
        out="$(hyprctl -j hyprglass status 2>/dev/null || true)"
        if ! jq -e '.shaders != "failed"' >/dev/null 2>&1 <<<"$out"; then
            plugin_unload "$name"; echo "hyprglass can't draw ($(jq -r '.shaders // "no status"' <<<"$out" 2>/dev/null || echo "no status"))"; return 1
        fi
    fi
}

# glass_apply [live]: put the settings' glass on screen. "live" (a clarity
# change) sends the numbers without re-adding the plugin's rules.
glass_apply() {
    local live="${1:-}" want pref mode backend reason="" clarity menubar cands c other why before
    want="$(get_str glass.mode)"; want="${want:-liquid}"
    [[ "$(get_str accessibility.reduceTransparency)" == true ]] && want=solid
    pref="$(get_str glass.backend)"; pref="${pref:-auto}"
    clarity="$(get_str glass.clarity)"; clarity="${clarity:-0.35}"
    menubar="$(get_str appearance.menuBarBackground)"; [[ "$menubar" == true ]] || menubar=false
    before="$(jq -r '"\(.mode)/\(.backend)"' "$GLASS_JSON" 2>/dev/null || true)"
    mode="$want"; backend=hyprland

    if ! active || ! have hyprctl; then
        :   # nothing on screen to change: only remember the choice
    elif [[ "$want" == liquid ]]; then
        case "$pref" in
            plugin|hyprglass) cands=(hyprglass) ;;
            hyprliquid) cands=(hyprliquid) ;;
            shader) cands=() ;;   # the shell's own (liquid.frag): Hyprland blurs nothing extra
            *) cands=(hyprglass hyprliquid) ;;
        esac
        backend=""
        for c in "${cands[@]}"; do
            # never two glass plugins at once
            for other in hyprglass hyprliquid; do [[ "$other" == "$c" ]] || plugin_unload "$other"; done
            if why="$(plugin_try "$c")"; then backend="$c"; break; fi
            reason="${reason:+$reason; }$why"
        done
        if [[ -z "$backend" ]]; then
            if [[ "$pref" == shader ]]; then backend=shader
            else mode=frosted; backend=hyprland; log "Liquid Glass is off: $reason; using Frosted"; fi
        fi
    fi
    if active && have hyprctl; then
        [[ "$backend" == hyprglass ]] || plugin_unload hyprglass
        [[ "$backend" == hyprliquid ]] || plugin_unload hyprliquid
    fi

    {
        echo "-- Written by gg glass; the rice's glass.lua reads it."
        printf 'return { mode = "%s", backend = "%s", clarity = %s, menubar = %s }\n' \
            "$mode" "$backend" "$clarity" "$menubar"
    } > "$GLASS_STATE.tmp" && mv -f "$GLASS_STATE.tmp" "$GLASS_STATE"
    jq -n --arg want "$want" --arg mode "$mode" --arg backend "$backend" --arg reason "$reason" \
        --argjson clarity "$clarity" '{want: $want, mode: $mode, backend: $backend, clarity: $clarity, reason: $reason}' \
        > "$GLASS_JSON.tmp" && mv -f "$GLASS_JSON.tmp" "$GLASS_JSON"

    active && have hyprctl || return 0
    [[ -f "$GLASS_LUA" ]] || { log "no $GLASS_LUA (rice-render goldengate)"; return 0; }
    # hyprliquid's rules outlive it: a reload clears them when it goes.
    # Otherwise an eval: the first time a plugin is in, with its rules.
    if [[ "$before" == */hyprliquid && "$backend" != hyprliquid ]]; then
        hyprctl reload >/dev/null || log "hyprctl reload failed"
    elif [[ -n "$live" && "$before" == "$mode/$backend" ]]; then
        hyprctl eval "GG_GLASS_LIVE = true; dofile([[$GLASS_LUA]])" >/dev/null || log "hyprctl eval failed"
    else
        hyprctl eval "dofile([[$GLASS_LUA]])" >/dev/null || log "hyprctl eval failed"
    fi
}

glass() {
    local modes=(liquid frosted solid) cur i v
    case "${1:-status}" in
        liquid|frosted|solid)
            set_str glass.mode "$1"
            # Frosted is Hyprland's blur: back to auto, so a Liquid later picks its best again
            if [[ "$1" == frosted ]]; then set_str glass.backend auto; fi
            glass_apply; recolour ;;
        next)
            cur="$(get_str glass.mode)"
            for i in 0 1 2; do [[ "${modes[$i]}" == "$cur" ]] && break; done
            [[ "${modes[$i]}" == "$cur" ]] || i=-1
            glass "${modes[$(( (i + 1) % 3 ))]}" ;;
        clarity)
            v="${2:-}"
            [[ "$v" =~ ^(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)$ ]] || die "usage: gg glass clarity 0..1 (0 Ultraclear, 1 Tinted)"
            set_json glass.clarity "$(awk -v v="$v" 'BEGIN { printf "%.2f", v }')"
            glass_apply live; recolour ;;
        backend)
            case "${2:-}" in auto|hyprglass|plugin|hyprliquid|shader) ;; *) die "usage: gg glass backend auto|hyprglass|hyprliquid|shader" ;; esac
            set_str glass.backend "$2"; glass_apply ;;
        apply) glass_apply ;;
        off) plugin_unload hyprglass; plugin_unload hyprliquid ;;
        status)
            if [[ -s "$GLASS_JSON" ]]; then jq -r '"\(.mode) (\(.backend)), clarity \(.clarity)" + (if .reason != "" then "\nwanted \(.want): \(.reason)" else "" end)' "$GLASS_JSON"
            else echo "not applied yet (gg glass apply)"; fi ;;
        *) die "usage: gg glass liquid|frosted|solid|next|clarity 0..1|backend NAME|apply|status" ;;
    esac
}

# ── wallpaper ────────────────────────────────────────────────────────────
wall_dir() { local d; d="$(get_str wallpaper.dir)"; d="${d:-~/Pictures/Wallpapers}"; echo "${d/#\~/$HOME}"; }
pictures() {
    find "$(wall_dir)" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
        -o -iname '*.webp' -o -iname '*.gif' \) 2>/dev/null | sort
}
# a picture's night twin: name-dark.* beside name-light.* (or "" when none)
twin() {
    local f="$1" stem dir g
    dir="$(dirname "$f")"; stem="$(basename "${f%.*}")"
    [[ "$stem" == *-light ]] || { echo ""; return; }
    for g in "$dir/${stem%-light}-dark".*; do [[ -f "$g" ]] && { echo "$g"; return; }; done
    echo ""
}
wall_set() {
    local f="$1" dark="${2:-}"
    [[ -f "$f" ]] || die "no such picture: $f"
    f="$(readlink -f "$f")"
    # a night twin chosen on its own: the pair is its day half
    if [[ -z "$dark" && "$(basename "${f%.*}")" == *-dark ]]; then
        local day; for day in "$(dirname "$f")/$(basename "${f%.*}" | sed 's/-dark$/-light/')".*; do
            [[ -f "$day" ]] && { dark="$f"; f="$day"; break; }; done
    fi
    [[ -n "$dark" ]] || dark="$(twin "$f")"
    set_str wallpaper.current "$f"
    set_str wallpaper.currentDark "$dark"
    log "wallpaper ${f/#$HOME/~}${dark:+ (night: ${dark/#$HOME/~})}"
    [[ "$(get_str appearance.accent)" == wallpaper ]] && accent wallpaper
    return 0
}
wall_step() {
    local cur list i n
    cur="$(get_str wallpaper.current)"; cur="${cur/#\~/$HOME}"
    # a pair counts once: its night half isn't a stop of its own
    mapfile -t list < <(pictures | grep -v -- '-dark\.[^.]*$')
    n=${#list[@]}; (( n )) || die "no pictures in $(wall_dir) (gg wall seed adds the repo's)"
    for i in "${!list[@]}"; do [[ "${list[$i]}" == "$cur" ]] && break; done
    [[ "${list[$i]:-}" == "$cur" ]] || i=-1
    wall_set "${list[$(( (i + $1 + n) % n ))]}"
}
# the repo's stills into the library, once each: Paper's desk is a real
# light/dark pair (paper-light / paper-dark)
wall_seed() {
    local dir src dst
    dir="$(wall_dir)"; mkdir -p "$dir"
    while IFS='|' read -r src dst; do
        src="$RICE_DIR/$src"
        [[ -f "$src" && ! -e "$dir/$dst" ]] || continue
        cp "$src" "$dir/$dst" && log "seeded $dst"
    done <<'EOF'
paper/assets/wall.png|paper-light.png
paper/assets/wall-dark.png|paper-dark.png
nacre/assets/wall-static-dark.png|nacre.png
abyss/assets/wall-static.png|abyss.png
satsuei/seed/wall.webp|satsuei.webp
EOF
    return 0
}
wall() {
    case "${1:-status}" in
        set) [[ -n "${2:-}" ]] || die "usage: gg wall set FILE [DARK]"; wall_set "$2" "${3:-}" ;;
        pick) qs -c goldengate ipc call wallpaper pick >/dev/null ;;
        next) wall_step 1 ;;
        prev) wall_step -1 ;;
        seed) wall_seed ;;
        init)
            # a first wallpaper: the library's first picture, seeded if empty
            [[ -n "$(get_str wallpaper.current)" ]] && return 0
            [[ -n "$(pictures | head -n1)" ]] || wall_seed
            local first
            first="$(pictures | grep -m1 -- '-light\.' || pictures | head -n1)"
            [[ -n "$first" ]] && wall_set "$first" ;;
        status)
            printf 'day   %s\nnight %s\nfolder %s\n' "$(get_str wallpaper.current)" \
                "$(get_str wallpaper.currentDark)" "$(wall_dir)" ;;
        *) die "usage: gg wall set FILE [DARK]|pick|next|prev|seed|status" ;;
    esac
}

# ── windows ──────────────────────────────────────────────────────────────
# The rice's session.lua (loaded by hypr.lua on every reload) holds Golden
# Gate's binds, floating, gestures and the GG.* window functions; these ask
# them. session-state.lua is what it reads from the settings.
SESSION_STATE="$STATE/session-state.lua"
ACTIVE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/rice/active"

session_write() {   # prints "changed" when the state is new
    local layout new
    layout="$(get_str windows.layout)"; [[ "$layout" == tiled ]] || layout=floating
    new="$(printf -- '-- Written by gg; the rice'"'"'s session.lua reads it.\nreturn { layout = "%s" }\n' "$layout")"
    [[ -f "$SESSION_STATE" && "$(cat "$SESSION_STATE")" == "$new" ]] && return 0
    printf '%s\n' "$new" > "$SESSION_STATE.tmp" && mv -f "$SESSION_STATE.tmp" "$SESSION_STATE"
    echo changed
}

# the traffic lights: hyprbars, loaded while Golden Gate is on screen. Its
# buttons go in once per load (a reload starts them afresh, from session.lua).
bars_apply() {
    active && have hyprctl || return 0
    loaded hyprbars && return 0
    local why
    if why="$(plugin_try hyprbars)"; then
        hyprctl eval "GG.bars(); dofile([[$ACTIVE_DIR/hypr-mode.lua]])" >/dev/null || log "hyprctl eval failed"
    else
        log "no traffic lights: $why"
    fi
}

lua() {   # lua CODE: in Hyprland, where session.lua defined GG
    active && have hyprctl || die "Golden Gate isn't the active rice"
    hyprctl eval "if GG then $1 end" >/dev/null
}
lua_str() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_.:-]//g'; }

win() {
    case "${1:-}" in
        close|quit|cycle) lua "GG.$1()" ;;
        zoom|fill|center)
            if [[ -n "${2:-}" ]]; then lua "GG.$1(\"0x$(lua_str "${2#0x}")\")"; else lua "GG.$1()"; fi ;;
        tilemenu)
            # under the pointer, for the window whose green light was clicked
            local addr pos
            addr="$(hyprctl activewindow -j | jq -r '.address // empty')"
            pos="$(hyprctl cursorpos -j | jq -r '"\(.x) \(.y)"')"
            [[ -n "$addr" ]] || return 0
            # shellcheck disable=SC2086
            qs -c goldengate ipc call tilemenu open "$addr" $pos >/dev/null ;;
        minimize) lua "GG.minimize()" ;;
        hide) lua "GG.hide()" ;;
        hide-others) lua "GG.hide_others()" ;;
        show-all) lua "GG.show_all()" ;;
        tile)
            case "${2:-}" in
                left|right|up|down|topleft|topright|bottomleft|bottomright)
                    if [[ -n "${3:-}" ]]; then lua "GG.tile(\"$2\", \"0x$(lua_str "${3#0x}")\")"; else lua "GG.tile(\"$2\")"; fi ;;
                *) die "usage: gg win tile left|right|up|down|topleft|topright|bottomleft|bottomright [ADDRESS]" ;;
            esac ;;
        restore) [[ -n "${2:-}" ]] || die "usage: gg win restore ADDRESS"; lua "GG.restore(\"0x$(lua_str "${2#0x}")\")" ;;
        unhide) [[ -n "${2:-}" ]] || die "usage: gg win unhide CLASS"; lua "GG.unhide(\"$(lua_str "$2")\")" ;;
        raise) [[ -n "${2:-}" ]] || die "usage: gg win raise ADDRESS"; lua "GG.raise(\"0x$(lua_str "${2#0x}")\")" ;;
        quit-app) [[ -n "${2:-}" ]] || die "usage: gg win quit-app CLASS"; lua "GG.quit_app(\"$(lua_str "$2")\")" ;;
        *) die "usage: gg win close|quit|minimize|zoom|fill|center|hide|hide-others|show-all|cycle|tile DIR|restore ADDRESS|unhide CLASS|quit-app CLASS|raise ADDRESS" ;;
    esac
}

# screenshots: the shell's (its toolbar and thumbnail), else rice-shot's
screenshot() {
    local what="${1:-selection}"
    has_surface capture shot "$what" && return 0
    case "$what" in
        screen) rice-shot screen ;;
        window) rice-shot window ;;
        toolbar) rice-shot edit ;;
        *) rice-shot region ;;
    esac
}

# ── hooks (the rice's hooks/ call these) ─────────────────────────────────
hook() {
    case "${1:-}" in
        enter)
            # before `rice` sets Golden Gate's GTK theme and cursor: the
            # user's own, to give back on leaving
            gg-theme save || log "couldn't save the theme settings" ;;
        post-switch)
            wall init || true
            # the first time (or after settings.json changed while away), the
            # overlay differs from what `rice` rendered: render once more.
            # (Not `rice recolour`: the switch running this hook holds rice's lock.)
            if write_overlay; then
                rice-render -q goldengate || log "rice-render failed"
                pkill -USR1 -x kitty 2>/dev/null || true
            fi
            gg-theme apply || log "gg-theme apply failed"
            # `rice` has reloaded Hyprland already: once more if the layout
            # it read was stale
            if [[ "$(session_write)" == changed ]]; then hyprctl reload >/dev/null || true; fi
            glass_apply
            bars_apply ;;
        post-mode)
            gg-theme apply "${2:-$(mode)}" || log "gg-theme apply failed" ;;
        leave)
            # the plugins are Golden Gate's only
            plugin_unload hyprglass; plugin_unload hyprliquid; plugin_unload hyprbars
            gg-theme restore || log "couldn't restore the theme settings" ;;
        *) die "usage: gg hook enter|post-switch|post-mode|leave" ;;
    esac
}

usage() { sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
    ""|-h|--help|help) usage ;;
    appearance|mode) shift; appearance "$@" ;;
    location) shift; location "$@" ;;
    accent) shift; accent "$@" ;;
    wall|wallpaper) shift; wall "$@" ;;
    glass) shift; glass "$@" ;;
    get) [[ -n "${2:-}" ]] || die "usage: gg get KEY"; get "$2" ;;
    set) [[ -n "${2:-}" && -n "${3:-}" ]] || die "usage: gg set KEY JSON"; set_json "$2" "$3"
         case "$2" in glass.*|accessibility.reduceTransparency|appearance.menuBarBackground) glass_apply ;; esac
         case "$2" in appearance.*|glass.*|accessibility.reduceTransparency) recolour ;; esac
         case "$2" in windows.*) if [[ "$(session_write)" == changed ]] && active && have hyprctl; then hyprctl reload >/dev/null; fi ;; esac ;;
    hook) shift; hook "$@" ;;
    dock) surface dock toggle ;;
    spotlight) surface spotlight toggle ;;
    mission) surface mission toggle ;;
    expose) surface mission expose ;;
    cc) surface controlcenter toggle ;;
    nc) surface notifications toggle ;;
    apps|launchpad) surface apps toggle ;;
    desktop) lua "GG.desktop()" ;;
    win|window) shift; win "$@" ;;
    switcher) shift; surface switcher "${1:-next}" ;;
    settings) shift; surface settings open "${1:-}" ;;
    lock) rice lock ;;
    screenshot) shift; screenshot "${1:-selection}" ;;
    record) shift; surface capture record "${1:-screen}" ;;
    island) shift; [[ "${1:-}" == test ]] || die "usage: gg island test ACTIVITY"; surface island test "${2:-}" ;;
    widgets) shift; surface widgets "${1:-edit}" ;;
    notify-done) shift; surface island commandDone "${1:-command}" "${2:-0}" ;;
    *) die "unknown command: $1 (gg --help)" ;;
esac
