// Generated by rice-render for {{ meta.title }}. Linked to ~/.config/fastfetch/config.jsonc.
// A typewriter, typed: the body in ink ($1), the paper in the platen and its
// lines in the ribbon's red ($2).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$2      .--------.\n$2      | $1~~~~~~ $2|\n$2      | $1~~~~   $2|\n$1   .--'--------'--.\n$1  [================]\n$1  / o o o o o o o  \\\n$1 / o o o o o o o o  \\\n$1/  o o o o o o o o   \\\n$1'-------[______]------'",
    "color": { "1": "blue", "2": "red" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "red" },
    "key": { "width": 9 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "terminalfont", "key": "font" },
    { "type": "shell",    "key": "shell" },
    { "type": "packages", "key": "pkgs" },
    { "type": "memory",   "key": "mem" },
    { "type": "uptime",   "key": "up" },
    { "type": "custom",   "key": "theme", "format": "{{ meta.title }} (light)" },
    "break",
    "colors"
  ]
}
