# Generated by rice-render for {{ meta.title }}: btop on graph paper.
# Linked to ~/.config/btop/themes/rice.theme.
# The page is paper, the boxes are graphite outlines, the graphs are drawn
# in ink and turn ribbon-red where they run high.
theme[main_bg]="{{ colors.paper }}"
theme[main_fg]="{{ colors.carbon }}"
theme[title]="{{ colors.ink }}"
theme[hi_fg]="{{ colors.red }}"
theme[selected_bg]="{{ colors.sticky | night(colors.kraft) }}"
theme[selected_fg]="{{ colors.carbon | night(colors.ink) }}"
theme[inactive_fg]="{{ ansi.color7 }}"
theme[graph_text]="{{ ansi.color7 }}"
theme[meter_bg]="{{ colors.crease }}"
theme[proc_misc]="{{ colors.ink }}"
theme[cpu_box]="{{ colors.graphite }}"
theme[mem_box]="{{ colors.graphite }}"
theme[net_box]="{{ colors.graphite }}"
theme[proc_box]="{{ colors.graphite }}"
theme[div_line]="{{ colors.rule }}"
theme[temp_start]="{{ colors.ink }}"
theme[temp_mid]="{{ ansi.color3 }}"
theme[temp_end]="{{ colors.red }}"
theme[cpu_start]="{{ colors.ink }}"
theme[cpu_mid]="{{ colors.ink | mix(colors.red, 0.5) }}"
theme[cpu_end]="{{ colors.red }}"
theme[free_start]="{{ ansi.color2 }}"
theme[free_mid]="{{ ansi.color2 }}"
theme[free_end]="{{ ansi.color2 }}"
theme[cached_start]="{{ colors.ink }}"
theme[cached_mid]="{{ colors.ink }}"
theme[cached_end]="{{ ansi.color12 }}"
theme[available_start]="{{ ansi.color3 }}"
theme[available_mid]="{{ ansi.color3 }}"
theme[available_end]="{{ ansi.color3 }}"
theme[used_start]="{{ colors.ink }}"
theme[used_mid]="{{ colors.ink | mix(colors.red, 0.5) }}"
theme[used_end]="{{ colors.red }}"
theme[download_start]="{{ colors.ink }}"
theme[download_mid]="{{ colors.ink }}"
theme[download_end]="{{ colors.red }}"
theme[upload_start]="{{ ansi.color5 }}"
theme[upload_mid]="{{ ansi.color5 }}"
theme[upload_end]="{{ colors.red }}"
theme[process_start]="{{ colors.ink }}"
theme[process_mid]="{{ colors.ink | mix(colors.red, 0.5) }}"
theme[process_end]="{{ colors.red }}"
