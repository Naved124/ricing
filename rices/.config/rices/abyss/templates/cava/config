# Generated by rice-render for {{ meta.title }}. Linked to ~/.config/cava/config
# (the shell runs its own cava; this is for cava in a terminal). Bars rise out
# of deep blue water through teal into violet.
[general]
framerate = 60
bar_width = 2
bar_spacing = 1

[input]
method = pipewire

[color]
gradient = 1
gradient_count = 3
gradient_color_1 = '{{ ansi.color4 | darken(0.35) }}'
gradient_color_2 = '{{ colors.glow }}'
gradient_color_3 = '{{ colors.glow2 }}'

[smoothing]
noise_reduction = 70
