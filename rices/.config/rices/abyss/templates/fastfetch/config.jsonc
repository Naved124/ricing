// Generated by rice-render for {{ meta.title }}. Linked to ~/.config/fastfetch/config.jsonc.
// A jellyfish: its bell in teal ($1), the tentacles trailing violet ($2);
// the keys violet like the mock's window.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1      .-''''-.\n$1    .'  $2.  .$1  '.\n$1   /  $2.' '' '.$1  \\\n$1  :              :\n$1   '.,_.,_.,_.,.'\n$2     ( ( ) ) ( (\n$2      ) ) ( ( ) )\n$2     ( (   ) ( (\n$2      '     '   '",
    "color": { "1": "cyan", "2": "magenta" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "cyan" },
    "key": { "width": 10 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "shell",    "key": "shell" },
    { "type": "packages", "key": "pkgs" },
    { "type": "memory",   "key": "mem" },
    { "type": "uptime",   "key": "up" },
    { "type": "custom",   "key": "rice", "format": "{{ meta.title }}" },
    "break",
    "colors"
  ]
}
