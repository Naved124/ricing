// Generated by rice-render from ~/.config/rices/abyss/palette.toml.
// Do not edit: change the palette and run `rice-render abyss`.
pragma Singleton

import QtQuick
import Quickshell

Singleton {
    id: root

    // ── the one mode ────────────────────────────────────────────────────────
    // Abyss is dark only ([meta] modes = ["dark"]): both names hold the dark
    // palette, so k never changes a colour, and the Mode below stays dark.
    readonly property var lightPalette: ({
        colors: {{ light.colors | json }},
        roles: {{ light.roles | json }},
        gradient: {{ light.gradient.stops | json }},
        opacity: {{ light.opacity | json }},
        wallpaper: {{ light.wallpaper | json }}
    })
    readonly property var darkPalette: ({
        colors: {{ dark.colors | json }},
        roles: {{ dark.roles | json }},
        gradient: {{ dark.gradient.stops | json }},
        opacity: {{ dark.opacity | json }},
        wallpaper: {{ dark.wallpaper | json }}
    })

    // ── the mock's tokens ───────────────────────────────────────────────────
    readonly property color abyss:       c("abyss")
    readonly property color glass:       c("glass")          // panels, 70%
    readonly property color glassStrong: c("glass_strong")   // cards and menus, 86%
    readonly property color line:        c("line")           // glass edges
    readonly property color glow:        c("glow")           // teal: life, focus
    readonly property color glow2:       c("glow2")          // violet: quiet
    readonly property color pink:        c("pink")           // alarm
    readonly property color ink:         c("ink")
    readonly property color inkDim:      c("ink_dim")
    readonly property color deep:        c("deep")
    readonly property color shoal:       c("shoal")
    readonly property color kelpGreen:   c("kelp_green")
    readonly property color sand:        c("sand")
    readonly property color sky:         c("sky")
    readonly property color greyInk:     c("grey_ink")

    // ── roles ───────────────────────────────────────────────────────────────
    readonly property color bg:        role("bg")
    readonly property color surface:   role("surface")
    readonly property color border:    role("border")
    readonly property color fg:        role("fg")
    readonly property color muted:     role("muted")
    readonly property color accent:    role("accent")
    readonly property color urgent:    role("urgent")
    readonly property color selection: role("selection")
    readonly property color success:   role("success")
    readonly property color warning:   role("warning")
    readonly property color shadow:    role("shadow")

    // glows and washes, all from the tokens: a soft teal halo, the faint fill
    // of a pressed button, a hover, and the line brightened for focus
    function glowAt(a) { return Qt.alpha(c("glow"), a); }
    function glow2At(a) { return Qt.alpha(c("glow2"), a); }
    function pinkAt(a) { return Qt.alpha(c("pink"), a); }
    function inkAt(a) { return Qt.alpha(c("ink"), a); }
    function lineAt(a) { return Qt.alpha(c("line"), a); }
    readonly property color wash:      Qt.alpha(c("glow"), 0.04)
    readonly property color washHover: Qt.alpha(c("glow"), 0.09)
    readonly property color washOn:    Qt.alpha(c("glow"), 0.14)
    readonly property color lineOn:    Qt.alpha(c("glow"), 0.6)

    // ── iridescence ─────────────────────────────────────────────────────────
    readonly property var gradient: {
        const stops = mixList(lightPalette.gradient, darkPalette.gradient);
        return stops.concat([stops[0]]);
    }

    // ── the reef ────────────────────────────────────────────────────────────
    readonly property var reef: darkPalette.wallpaper
    readonly property vector3d waterTop:    vec(reef.water_top)
    readonly property vector3d waterMid:    vec(reef.water_mid)
    readonly property vector3d waterBottom: vec(reef.water_bottom)
    // the creatures' colours, as reef.js draws them (CSS for its canvas)
    readonly property var reefColors: ({
        ridge: css("ridge"), kelp: css("kelp"), floorTop: css("floor_top"), floorBottom: css("floor_bottom"),
        floorLine: css("floor_line"), anemoneBase: css("anemone_base"), fish: css("fish"),
        photophore: css("photophore"), plankton: css("plankton")
    })
    readonly property var reefHues: ({
        creatures: reef.creatures, jellies: reef.jellies, fans: reef.fans, anemones: reef.anemones,
        sparkle: reef.sparkle, plankton: reef.plankton, back: reef.back_shift
    })

    // ── type ────────────────────────────────────────────────────────────────
    readonly property string fontDisplay: "{{ fonts.display }}"
    readonly property string fontUi:      "{{ fonts.ui }}"
    readonly property string fontMono:    "{{ fonts.mono }}"
    readonly property real   uiSize:      {{ fonts.ui_size }}
    readonly property real   monoSize:    {{ fonts.mono_size }}
    readonly property int    weight:        {{ fonts.weight }}
    readonly property int    weightStrong:  {{ fonts.weight_strong }}
    readonly property int    weightDisplay: {{ fonts.display_weight }}

    // ── shape ───────────────────────────────────────────────────────────────
    readonly property int radiusWindow: {{ shape.window }}
    readonly property int radiusPanel:  {{ shape.panel }}
    readonly property int radiusPopup:  {{ shape.popup }}
    readonly property int radiusChip:   {{ shape.chip }}
    readonly property int gapsOut:      {{ shape.gaps_out }}

    // ── motion ──────────────────────────────────────────────────────────────
    // drift is the default; settle for arrivals; sink for dismissals
    readonly property var drift:  {{ motion.bloom | curve }}
    readonly property var bloom:  drift
    readonly property var settle: {{ motion.settle | curve }}
    readonly property var sink:   {{ motion.sink | curve }}

    readonly property int durOpen:      {{ motion.open }}
    readonly property int durClose:     {{ motion.close }}
    readonly property int durMove:      {{ motion.move }}
    readonly property int durWorkspace: {{ motion.workspace }}
    readonly property int durFocus:     {{ motion.focus }}
    readonly property int durPanelIn:   {{ motion.panel_in }}
    readonly property int durPanelOut:  {{ motion.panel_out }}
    readonly property int stagger:      {{ motion.stagger }}

    // ── the mode ────────────────────────────────────────────────────────────
    readonly property Mode mode: Mode { curve: root.drift; only: "dark" }
    readonly property bool dark: mode.dark
    readonly property real k: mode.k

    function c(name) { return mode.mix(lightPalette.colors[name], darkPalette.colors[name]); }
    function role(name) { return mode.mix(lightPalette.roles[name], darkPalette.roles[name]); }
    function cc(day, night) { return mode.mix(lightPalette.colors[day], darkPalette.colors[night]); }
    function opacityOf(name) { return mode.blend(lightPalette.opacity[name], darkPalette.opacity[name]); }
    function mixList(a, b) { return a.map((x, i) => mode.mix(x, b[i] ?? x)); }
    function vec(v) { return Qt.vector3d(v[0], v[1], v[2]); }
    // a palette colour as the canvas wants it, rgba() with its alpha
    function css(name) {
        const v = c(name);
        return `rgba(${Math.round(v.r * 255)},${Math.round(v.g * 255)},${Math.round(v.b * 255)},${+v.a.toFixed(3)})`;
    }
}
