# Generated by rice-render for {{ meta.title }}. In ~/.config/zathura/zathurarc:
#   include rice
set font                    "{{ fonts.ui }} {{ fonts.app_size | add(1) }}"
set default-bg              "{{ roles.term_bg }}"
set default-fg              "{{ roles.fg }}"
set statusbar-bg            "{{ roles.surface }}"
set statusbar-fg            "{{ roles.fg }}"
set inputbar-bg             "{{ roles.surface }}"
set inputbar-fg             "{{ roles.fg }}"
set notification-bg         "{{ roles.surface }}"
set notification-fg         "{{ roles.fg }}"
set notification-error-bg   "{{ roles.urgent }}"
set notification-error-fg   "{{ roles.fg }}"
set notification-warning-bg "{{ roles.warning }}"
set notification-warning-fg "{{ roles.fg }}"
set completion-bg           "{{ roles.surface }}"
set completion-fg           "{{ roles.fg }}"
set completion-group-bg     "{{ roles.term_bg }}"
set completion-group-fg     "{{ roles.muted }}"
set completion-highlight-bg "{{ roles.selection }}"
set completion-highlight-fg "{{ roles.fg }}"
set index-bg                "{{ roles.term_bg }}"
set index-fg                "{{ roles.fg }}"
set index-active-bg         "{{ roles.selection }}"
set index-active-fg         "{{ roles.fg }}"
set highlight-color         "{{ roles.warning | rgba(0.5) }}"
set highlight-active-color  "{{ roles.accent | rgba(0.6) }}"
set highlight-fg            "{{ roles.fg }}"
set render-loading-bg       "{{ roles.term_bg }}"
set render-loading-fg       "{{ roles.muted }}"

# Ctrl+R: read in the rice's own colours
set recolor-lightcolor      "{{ roles.term_bg }}"
set recolor-darkcolor       "{{ roles.fg }}"
set recolor-keephue         true

set window-title-basename   true
set statusbar-h-padding     14
set statusbar-v-padding     6
set page-padding            8
