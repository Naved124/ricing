// Generated by rice-render from ~/.config/rices/satsuei/palette.toml.
// Do not edit: change the palette and run `rice-render satsuei`.
//
// What of Satsuei never changes with the wallpaper: type, shape, motion and
// the characters' fixed art colours. The colours that come from the plate are
// in Theme.qml, read from satsuei-wall's theme.json. This file must not read
// a colour the overlay writes (it's committed, and has to render the same
// whatever wallpaper is set).
pragma Singleton

import QtQuick
import Quickshell

Singleton {
    // ── type ────────────────────────────────────────────────────────────────
    readonly property string fontDisplay: "{{ fonts.display }}"
    readonly property string fontUi:      "{{ fonts.ui }}"
    readonly property string fontMono:    "{{ fonts.mono }}"
    readonly property real   uiSize:      {{ fonts.ui_size }}
    readonly property real   monoSize:    {{ fonts.mono_size }}
    readonly property int    weight:        {{ fonts.weight }}
    readonly property int    weightStrong:  {{ fonts.weight_strong }}
    readonly property int    weightDisplay: {{ fonts.display_weight }}

    // ── shape ───────────────────────────────────────────────────────────────
    readonly property int radiusWindow: {{ shape.window }}
    readonly property int radiusPanel:  {{ shape.panel }}
    readonly property int radiusPopup:  {{ shape.popup }}
    readonly property int radiusChip:   {{ shape.chip }}
    readonly property int gapsIn:       {{ shape.gaps_in }}
    readonly property int gapsOut:      {{ shape.gaps_out }}
    readonly property real glassOpacity: {{ opacity.glass }}

    // ── motion ──────────────────────────────────────────────────────────────
    readonly property var bloom:  [{{ motion.bloom | join(", ") }}, 1, 1]
    readonly property var settle: [{{ motion.settle | join(", ") }}, 1, 1]
    readonly property var sink:   [{{ motion.sink | join(", ") }}, 1, 1]
    readonly property int durOpen:      {{ motion.open }}
    readonly property int durClose:     {{ motion.close }}
    readonly property int durWorkspace: {{ motion.workspace }}
    readonly property int durPanelIn:   {{ motion.panel_in }}
    readonly property int durPanelOut:  {{ motion.panel_out }}
    readonly property int stagger:      {{ motion.stagger }}

    // ── the characters' own colours (skin, eyes, highlights) ────────────────
    // everything else on them is the theme's: accent, accent2, tint, hair
    readonly property var art: ({
        skin: "{{ colors.art_skin }}", blush: "{{ colors.art_blush }}", eye: "{{ colors.art_eye }}",
        shine: "{{ colors.art_shine }}", mouth: "{{ colors.art_mouth }}", cream: "{{ colors.art_cream }}",
        sock: "{{ colors.art_sock }}", fox: "{{ colors.art_fox }}", robot: "{{ colors.art_robot }}",
        screen: "{{ colors.art_screen }}", ghost: "{{ colors.art_ghost }}"
    })
}
