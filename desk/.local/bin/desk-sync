#!/usr/bin/env python3
"""desk-sync: mirrors the Notion Desk page into ~/.cache/desk/state.json.

The only program that holds the Notion credential or talks to the network;
the shells read the cache and write through its subcommands. See
`desk-sync --help`, and desksync/ next to this file for the parts.
"""

import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(here, "..", "lib", "desk"))

from desksync.cli import main  # noqa: E402

sys.exit(main())
