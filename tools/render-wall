#!/usr/bin/env python3
"""Render Nacre's live wallpaper (quickshell/.../nacre/shaders/wallpaper.frag.qsb)
to a still: rices/nacre/assets/wall-static-<mode>.png, at a fixed time with no
ripple. tests/test_night.py checks the dark one's luminance; it is also a
fallback still when the shell isn't running.

    tools/render-wall [light|dark] [--size 1920x1080] [--time 40]

Needs PySide6 and a GL context (run under xvfb-run when headless).
"""
import argparse
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SHADER = REPO / "quickshell/.config/quickshell/nacre/shaders/wallpaper.frag.qsb"

loader = importlib.machinery.SourceFileLoader("rice_render", str(REPO / "render/.local/bin/rice-render"))
spec = importlib.util.spec_from_loader("rice_render", loader)
rr = importlib.util.module_from_spec(spec)
loader.exec_module(rr)

QML = """
import QtQuick
ShaderEffect {
    width: %(w)d; height: %(h)d
    fragmentShader: "%(shader)s"
    property color ground0: "%(g0)s"
    property color ground1: "%(g1)s"
    property color lilac: "%(lilac)s"
    property color c0: "%(c0)s"
    property color c1: "%(c1)s"
    property color c2: "%(c2)s"
    property color c3: "%(c3)s"
    property color c4: "%(c4)s"
    property color a0: "%(a0)s"
    property color a1: "%(a1)s"
    property color a2: "%(a2)s"
    property size resolution: Qt.size(width, height)
    property real time: %(t)f
    property point ripplePos: Qt.point(0.5, 0.5)
    property real rippleAge: -1
    property real dark: %(dark)d
}
"""


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("mode", nargs="?", default="dark", choices=["light", "dark"])
    ap.add_argument("--size", default="1920x1080")
    ap.add_argument("--time", type=float, default=40.0)
    ap.add_argument("--out", type=Path)
    a = ap.parse_args()
    w, h = (int(v) for v in a.size.split("x"))
    ctx = rr.load_modes(REPO / "rices/.config/rices/nacre")[a.mode]
    wp = ctx["wallpaper"]
    col = lambda v: ctx["colors"].get(v, v)
    values = {"w": w, "h": h, "shader": SHADER.as_uri(), "t": a.time, "dark": a.mode == "dark",
              "g0": col(wp["ground"][0]), "g1": col(wp["ground"][1]), "lilac": ctx["colors"]["lilac"],
              **{f"c{i}": col(v) for i, v in enumerate(wp["blooms"])},
              **{f"a{i}": col(v) for i, v in enumerate(wp["accents"])}}
    out = a.out or REPO / f"rices/.config/rices/nacre/assets/wall-static-{a.mode}.png"
    out.parent.mkdir(parents=True, exist_ok=True)

    from PySide6.QtCore import QUrl, QTimer
    from PySide6.QtGui import QGuiApplication
    from PySide6.QtQuick import QQuickView

    app = QGuiApplication(sys.argv[:1])
    qml = out.parent / ".render-wall.qml"
    qml.write_text(QML % values)
    view = QQuickView()
    view.setSource(QUrl.fromLocalFile(str(qml)))
    view.show()

    def grab():
        img = view.grabWindow()
        qml.unlink()
        ok = img.save(str(out))
        print(f"  {out}" if ok else "render-wall: could not save", file=sys.stdout if ok else sys.stderr)
        app.exit(0 if ok else 1)

    QTimer.singleShot(800, grab)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
