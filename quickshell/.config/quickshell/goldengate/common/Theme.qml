// Generated by rice-render from ~/.config/rices/goldengate/palette.toml.
// Do not edit: change the palette and run `rice-render goldengate`.
pragma Singleton

import QtQuick
import Quickshell
import qs.services

// Golden Gate's colours, fonts, shapes and springs. Apple's system colours
// are fixed (both modes below); the accent and the glass are the user's
// (Settings). Every colour is mixed between light and dark by k, so the whole
// shell crossfades when the mode changes.
Singleton {
    id: root

    // ── light and dark ──────────────────────────────────────────────────────
    readonly property Mode mode: Mode {}
    readonly property bool dark: mode.dark
    readonly property real k: mode.k

    readonly property var lightPalette: ({ colors: {"window": "#ececec", "control": "#ffffff", "under_page": "#e3e3e3", "grouped": "#f5f5f7", "ink": "#000000", "paper": "#ffffff", "label": "#232323", "label2": "#767676", "separator": "#d4d4d4", "selection": "#b3d7ff", "link": "#0068da", "shadow": "#000000", "blue": "#007aff", "purple": "#af52de", "pink": "#ff2d55", "red": "#ff3b30", "orange": "#ff9500", "yellow": "#ffcc00", "green": "#28cd41", "graphite": "#8e8e93", "teal": "#30b0c7", "indigo": "#5856d6", "mint": "#00c7be", "brown": "#a2845e", "close": "#ff5f57", "minimize": "#febc2e", "zoom": "#28c840", "island": "#000000", "frost": "#fbfbfd", "frost_rim": "#ffffff", "mic_dot": "#ff9500", "cam_dot": "#28cd41"} })
    readonly property var darkPalette: ({ colors: {"window": "#323232", "control": "#1e1e1e", "under_page": "#282828", "grouped": "#262626", "ink": "#ffffff", "paper": "#ffffff", "label": "#dddddd", "label2": "#8e8e8e", "separator": "#3a3a3a", "selection": "#3f638b", "link": "#419cff", "shadow": "#000000", "blue": "#0a84ff", "purple": "#bf5af2", "pink": "#ff375f", "red": "#ff453a", "orange": "#ff9f0a", "yellow": "#ffd60a", "green": "#32d74b", "graphite": "#98989d", "teal": "#40c8e0", "indigo": "#5e5ce6", "mint": "#63e6e2", "brown": "#ac8e68", "close": "#ff5f57", "minimize": "#febc2e", "zoom": "#28c840", "island": "#000000", "frost": "#1c1c1e", "frost_rim": "#ffffff", "mic_dot": "#ff9f0a", "cam_dot": "#32d74b"} })

    function c(name) { return mode.mix(lightPalette.colors[name], darkPalette.colors[name]); }
    // one colour by day, another at night
    function cc(day, night) { return mode.mix(lightPalette.colors[day], darkPalette.colors[night]); }
    // the colour at either end, for things that pick rather than mix
    function at(name, isDark) { return mode.rgba((isDark ? darkPalette : lightPalette).colors[name]); }

    // ── backgrounds (NSColor) ───────────────────────────────────────────────
    readonly property color window:    c("window")
    readonly property color control:   c("control")
    readonly property color underPage: c("under_page")
    readonly property color grouped:   c("grouped")
    readonly property color island:    c("island")

    // ── labels: black or white at 85/50/25/10% (more with Increase contrast) ─
    readonly property bool contrast: Settings.accessibility.increaseContrast
    readonly property color label:     Qt.alpha(c("ink"), contrast ? 0.95 : 0.85)
    readonly property color label2:    Qt.alpha(c("ink"), contrast ? 0.68 : 0.5)
    readonly property color label3:    Qt.alpha(c("ink"), contrast ? 0.45 : 0.25)
    readonly property color label4:    Qt.alpha(c("ink"), contrast ? 0.2 : 0.1)
    readonly property color separator: Qt.alpha(c("ink"), contrast ? 0.3 : 0.1)
    // fills: controls, hover and pressed rows, the quaternary system fill
    readonly property color fill:      Qt.alpha(c("ink"), mode.blend(0.05, 0.1))
    readonly property color fillHover: Qt.alpha(c("ink"), mode.blend(0.08, 0.14))
    readonly property color fillPress: Qt.alpha(c("ink"), mode.blend(0.14, 0.2))
    // on an accent fill: white, as on the Mac
    readonly property color onAccent:  c("paper")
    readonly property color linkColor: c("link")
    readonly property color selection: c("selection")

    // ── the accent ──────────────────────────────────────────────────────────
    // Multicolor is blue for the system; "From wallpaper" is the picture's,
    // snapped to an Apple hue (gg accent wallpaper writes both modes')
    readonly property var accentNames: ["multicolor", "blue", "purple", "pink", "red", "orange", "yellow", "green", "graphite"]
    readonly property string accentName: Settings.appearance.accent
    readonly property color accent: accentOf(accentName, c("blue"))
    function accentOf(name, fallback) {
        if (name === "wallpaper") {
            const w = Settings.appearance.accentWall ?? {};
            return w.light && w.dark ? mode.mix(w.light, w.dark) : fallback;
        }
        if (name === "multicolor" || !lightPalette.colors[name])
            return fallback;
        return c(name);
    }
    // the swatch for a name, as the accent dots draw it
    function swatch(name) { return name === "multicolor" ? c("blue") : accentOf(name, c("blue")); }
    readonly property color accentSoft: Qt.alpha(accentOf(accentName, c("blue")), mode.blend(0.16, 0.24))

    // Apple's other system colours, for icons and app tints
    readonly property color blue:     c("blue")
    readonly property color purple:   c("purple")
    readonly property color pink:     c("pink")
    readonly property color red:      c("red")
    readonly property color orange:   c("orange")
    readonly property color yellow:   c("yellow")
    readonly property color green:    c("green")
    readonly property color graphite: c("graphite")
    readonly property color teal:     c("teal")
    readonly property color indigo:   c("indigo")
    readonly property color mint:     c("mint")
    readonly property color brown:    c("brown")
    readonly property color closeLight:    c("close")
    readonly property color minimizeLight: c("minimize")
    readonly property color zoomLight:     c("zoom")
    readonly property color micDot:   c("mic_dot")
    readonly property color camDot:   c("cam_dot")

    // ── glass ───────────────────────────────────────────────────────────────
    // Liquid and Frosted draw a tint over what's behind (hyprglass or
    // Hyprland's blur does the bending and blurring); its strength is the
    // clarity: 0 Ultraclear, 1 Tinted. Solid (or Reduce transparency) is the
    // window colour, opaque.
    // what's on screen (Glass), which is Frosted when a Liquid can't run
    readonly property string glassMode: Glass.mode
    readonly property bool solid: glassMode === "solid"
    // a plugin draws the bend and the light: the shell adds only its tint
    readonly property bool liquidPlugin: Glass.plugin
    // no plugin: the shell bends and blurs a copy of the wallpaper itself
    readonly property bool shaderGlass: glassMode === "liquid" && Glass.backend === "shader"
    readonly property real clarity: Math.max(0, Math.min(1, Settings.glass.clarity))
    // how much of the tint covers a panel at this clarity
    readonly property real glassAlpha: solid ? 1 : mode.blend(0.12 + 0.68 * clarity, 0.2 + 0.65 * clarity)
    readonly property color glass:      solid ? c("window") : Qt.alpha(c("frost"), glassAlpha)
    // a stronger pane: menus, the Spotlight field, popovers
    readonly property color glassThick: solid ? c("window") : Qt.alpha(c("frost"), Math.min(1, glassAlpha + 0.18))
    // the rim the light catches, and the inner edge
    readonly property color glassRim:   Qt.alpha(c("frost_rim"), solid ? 0 : mode.blend(0.55, 0.16))
    readonly property color glassEdge:  Qt.alpha(c("ink"), contrast ? 0.35 : mode.blend(0.08, 0.14))
    // under a plugin, faint enough to stay out of its mask (below 0.06)
    readonly property color glassShadow: Qt.alpha(c("shadow"), liquidPlugin ? 0.04 : mode.blend(0.18, 0.45))
    // text sitting straight on the wallpaper (the menu bar without its
    // background): white with a soft shadow in both modes, as in Tahoe
    readonly property color onWallpaper:       c("paper")
    readonly property color onWallpaperShadow: Qt.alpha(c("shadow"), 0.45)

    // ── type ────────────────────────────────────────────────────────────────
    function family(want, fallback) { return Qt.fontFamilies().indexOf(want) >= 0 ? want : fallback; }
    readonly property string fontUi:      family("SF Pro Text", "Inter")
    readonly property string fontDisplay: family("SF Pro Display", "Inter Display")
    readonly property string fontRounded: family("SF Pro Rounded", "Inter")
    readonly property string fontMono:    family("SF Mono", "JetBrains Mono")
    readonly property string fontSerif:   family("New York", "serif")
    // the Mac's sizes, scaled to the rice's (14 px text)
    readonly property real textSize:  14
    readonly property real smallSize: 12
    readonly property real titleSize: 17

    // ── shape ───────────────────────────────────────────────────────────────
    readonly property int radiusWindow: 16
    readonly property int radiusPanel:  24
    readonly property int radiusPopup:  12
    readonly property int radiusChip:   8

    // ── motion ──────────────────────────────────────────────────────────────
    // springs (SpringAnimation); Reduce motion turns them into 150 ms fades
    readonly property bool reduceMotion: Settings.reduceMotion
    readonly property real spring: 3.2       // stiffness
    readonly property real damping: 0.26     // a little bounce
    readonly property real springSoft: 2.2
    readonly property real dampingSoft: 0.32
    readonly property int fadeMs: 150
    readonly property int panelIn: reduceMotion ? fadeMs : 380
    readonly property int panelOut: reduceMotion ? fadeMs : 220
}
