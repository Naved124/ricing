import QtQuick
import QtQuick.Shapes
import "paper.js" as P

// A small icon drawn in pencil: polylines on a 24×24 grid, each nudged a
// little so the lines look drawn by hand. Same seed, same drawing.
Item {
    id: root

    property string name: "speaker"
    property color color: Theme.pencil
    property real size: 20
    property real penWidth: 1.6
    property int seed: P.hash(name)

    implicitWidth: size
    implicitHeight: size

    // name → list of polylines (points on 24×24)
    readonly property var glyphs: ({
        speaker: [[[4, 9], [8, 9], [13, 5], [13, 19], [8, 15], [4, 15], [4, 9]],
                  [[16, 9.5], [17.4, 12], [16, 14.5]],
                  [[18.6, 7], [20.6, 12], [18.6, 17]]],
        "speaker-off": [[[4, 9], [8, 9], [13, 5], [13, 19], [8, 15], [4, 15], [4, 9]],
                        [[16, 9.5], [21, 14.5]], [[21, 9.5], [16, 14.5]]],
        mic: [[[9, 4], [15, 4], [15, 13], [9, 13], [9, 4]],
              [[6, 11], [7, 15], [12, 17], [17, 15], [18, 11]], [[12, 17], [12, 21]], [[8.5, 21], [15.5, 21]]],
        sun: [[[12, 8], [15, 9.5], [16, 12], [15, 14.5], [12, 16], [9, 14.5], [8, 12], [9, 9.5], [12, 8]],
              [[12, 2.5], [12, 5]], [[12, 19], [12, 21.5]], [[2.5, 12], [5, 12]], [[19, 12], [21.5, 12]],
              [[5.2, 5.2], [7, 7]], [[17, 17], [18.8, 18.8]], [[5.2, 18.8], [7, 17]], [[17, 7], [18.8, 5.2]]],
        wifi: [[[3, 9.5], [7, 6.3], [12, 5], [17, 6.3], [21, 9.5]],
               [[6, 12.8], [9, 10.8], [12, 10.2], [15, 10.8], [18, 12.8]],
               [[9, 16], [12, 14.8], [15, 16]], [[11.6, 19], [12.4, 19.4]]],
        bluetooth: [[[7, 7.5], [17, 16.5], [12, 21], [12, 3], [17, 7.5], [7, 16.5]]],
        bell: [[[6, 17], [7, 10], [9, 6.5], [12, 5.5], [15, 6.5], [17, 10], [18, 17], [6, 17]],
               [[10, 19.5], [12, 20.5], [14, 19.5]], [[12, 3], [12, 5.5]]],
        moon: [[[15, 3.5], [9, 5], [6, 10], [7, 16], [12, 20], [18, 19.5], [21, 15], [16, 15], [12, 12], [12, 7], [15, 3.5]]],
        grain: [[[4, 6], [10, 5], [16, 7], [20, 6]], [[4, 11], [9, 12], [15, 10.5], [20, 12]],
                [[4, 17], [11, 16], [16, 18], [20, 17]]],
        lock: [[[6, 11], [18, 11], [18, 20], [6, 20], [6, 11]], [[8.5, 11], [8.5, 7], [12, 4.5], [15.5, 7], [15.5, 11]]],
        power: [[[12, 3], [12, 12]], [[7.5, 6.5], [5, 10], [5.5, 15], [9, 19], [12, 20], [15, 19], [18.5, 15], [19, 10], [16.5, 6.5]]],
        keys: [[[3, 7], [21, 7], [21, 17], [3, 17], [3, 7]],
               [[6, 10], [7, 10]], [[10, 10], [11, 10]], [[14, 10], [15, 10]], [[18, 10], [18.5, 10]],
               [[7, 14], [17, 14]]],
        battery: [[[2, 6.5], [19, 6], [19.5, 18], [2.5, 18.5], [2, 6.5]], [[20, 9.5], [22, 9.7], [22, 14.6], [20, 14.6]]],
        bin: [[[4, 6], [20, 6], [18, 21], [6, 21], [4, 6]], [[9.5, 6], [10, 21]], [[14.5, 6], [14, 21]], [[3, 6], [21, 6]]],
        bolt: [[[13, 3], [6, 13.5], [11.5, 13.5], [10.5, 21], [18, 9.5], [12.5, 9.5], [13, 3]]],
        note: [[[5, 4], [19, 4], [19, 15], [14, 20], [5, 20], [5, 4]], [[14, 20], [14, 15], [19, 15]]],
        check: [[[4, 13], [9, 18.5], [20, 5]]],
        cross: [[[6, 6], [18, 18]], [[18, 6], [6, 18]]],
    })

    readonly property string data_: {
        const lines = glyphs[name] ?? glyphs.note;
        const k = size / 24;
        return lines.map((l, i) => P.pencil(l.map(p => [p[0] * k, p[1] * k]), seed + i, 0.5 * k, false)).join(" ");
    }

    Shape {
        anchors.fill: parent
        preferredRendererType: Shape.CurveRenderer
        ShapePath {
            fillColor: "transparent"
            strokeColor: root.color
            strokeWidth: root.penWidth
            capStyle: ShapePath.RoundCap
            joinStyle: ShapePath.RoundJoin
            PathSvg { path: root.data_ }
        }
    }
}
